---
import type { Locale, Pet } from "@jojo-codex-pet/catalog";
import { localize, route, ui } from "../lib/i18n";

interface Props {
  pet: Pet;
  locale: Locale;
  priority?: boolean;
}

const { pet, locale, priority = false } = Astro.props;
const copy = ui[locale];
const name = localize(pet.name, locale);
const detailUrl = route(locale, `/pets/${pet.id}/`);
const initial = pet.name.en.replace(/^(The|Gold|Made)\s/i, "").charAt(0);
const cardImages = pet.image ? {
  small: pet.image.replace(/\.png$/, "-card-320.webp"),
  medium: pet.image.replace(/\.png$/, "-card-480.webp"),
  large: pet.image.replace(/\.png$/, "-card-640.webp"),
  fallback: pet.image.replace(/\.png$/, "-card.webp")
} : undefined;
const imageAlt = locale === "en"
  ? `${name}, Part ${pet.part} pixel Codex pet`
  : `${name}，JoJo 第 ${pet.part} 部像素 Codex 宠物`;
const paletteLabel = locale === "en" ? "Locked signature palette" : "锁定标志配色";
---

<article
  class="pet-card"
  data-catalog-card
  data-pet-id={pet.id}
  data-part={`part-${String(pet.part).padStart(2, "0")}`}
  data-type={pet.type}
  data-status={pet.status}
>
  <a class="pet-card-link" href={detailUrl} aria-label={`${copy.open}: ${name}`}>
    <div class="pet-card-content">
      <div class="pet-art" style={`--part-accent: var(--part-${pet.part})`}>
        {cardImages ? (
          <img
            src={cardImages.fallback}
            srcset={`${cardImages.small} 320w, ${cardImages.medium} 480w, ${cardImages.large} 640w`}
            sizes="(max-width: 384px) calc(92vw - 23.92px), (max-width: 540px) 330px, (max-width: 775px) calc(46vw - 26.68px), (max-width: 840px) 330px, (max-width: 1178px) calc(30.6667vw - 31.28px), (max-width: 1180px) 330px, (max-width: 1512px) calc(23vw - 30.82px), 316.94px"
            alt={imageAlt}
            width="640"
            height="640"
            loading={priority ? "eager" : "lazy"}
            fetchpriority={priority ? "high" : undefined}
            decoding="async"
          />
        ) : (
          <div class="planned-art" aria-hidden="true">
            <span>{initial}</span>
            <i>{String(pet.part).padStart(2, "0")}</i>
          </div>
        )}
        <span class="part-tag">PART {String(pet.part).padStart(2, "0")}</span>
      </div>
      <div class="pet-copy">
        <div class="pet-meta">
          <span class="status-pill" data-status={pet.status}>{copy.status[pet.status]}</span>
          <span class="type-pill">{copy.type[pet.type]}</span>
        </div>
        <h3>{name}</h3>
        <p>{copy.role[pet.role]}</p>
        {pet.palette && (
          <div class="palette" aria-label={paletteLabel}>
            {pet.palette.map((color) => <span style={`--swatch:${color}`} title={color}></span>)}
          </div>
        )}
        <div class="pet-actions">
          <span class="open-link" aria-hidden="true">{copy.open} ↗</span>
          <span class="view-count" data-view-count={pet.id}>— {copy.view}</span>
        </div>
      </div>
    </div>
  </a>
</article>

<style define:vars={{
  "--part-1": "#d84b57",
  "--part-2": "#e69a38",
  "--part-3": "#7657d9",
  "--part-4": "#e553a4",
  "--part-5": "#d7b63f",
  "--part-6": "#54a58a",
  "--part-7": "#b56b3d",
  "--part-8": "#4ca7ba",
  "--part-9": "#6fbe5b"
}}>
  .pet-card {
    position: relative;
    min-width: 0;
    overflow: hidden;
    border: 3px solid var(--ink);
    background: var(--paper-bright);
    box-shadow: 6px 6px 0 var(--ink);
    transition: transform 160ms ease, box-shadow 160ms ease;
  }

  .pet-card:hover,
  .pet-card:focus-within {
    box-shadow: 9px 9px 0 var(--ink);
    transform: translate(-2px, -2px);
  }

  .pet-card:focus-within {
    outline: 4px solid var(--cyan);
    outline-offset: 4px;
  }

  .pet-card-link {
    display: block;
    color: inherit;
    text-decoration: none;
    touch-action: manipulation;
  }

  .pet-card-link:focus-visible {
    outline-color: transparent;
  }

  .pet-card[hidden] {
    display: none;
  }

  .pet-art {
    position: relative;
    display: grid;
    min-height: 290px;
    place-items: center;
    overflow: hidden;
    background:
      linear-gradient(135deg, rgb(255 255 255 / 44%) 0 12%, transparent 12% 74%, rgb(23 19 30 / 17%) 74%),
      var(--part-accent);
    border-bottom: 3px solid var(--ink);
  }

  .pet-art::after {
    position: absolute;
    right: -70px;
    bottom: -80px;
    width: 210px;
    height: 210px;
    content: "";
    border: 32px solid rgb(255 255 255 / 26%);
    border-radius: 50%;
  }

  .pet-art img {
    position: relative;
    z-index: 1;
    width: min(92%, 330px);
    height: 280px;
    object-fit: contain;
    image-rendering: pixelated;
    filter: drop-shadow(4px 5px 0 rgb(23 19 30 / 45%));
    transition: transform 180ms ease;
  }

  .pet-card:hover .pet-art img,
  .pet-card:focus-within .pet-art img {
    transform: scale(1.025);
  }

  .planned-art {
    position: relative;
    z-index: 1;
    display: grid;
    width: 160px;
    height: 190px;
    place-items: center;
    color: var(--paper-bright);
    background: var(--ink);
    clip-path: polygon(20% 0, 84% 8%, 100% 48%, 76% 100%, 11% 91%, 0 42%);
  }

  .planned-art span {
    font-family: "Bodoni Moda Variable", Georgia, serif;
    font-size: 7rem;
    font-weight: 900;
    line-height: 0.8;
  }

  .planned-art i {
    position: absolute;
    right: 24px;
    bottom: 18px;
    color: var(--acid);
    font-size: 0.72rem;
    font-style: normal;
    font-weight: 850;
    letter-spacing: 0.16em;
  }

  .part-tag {
    position: absolute;
    z-index: 2;
    top: 14px;
    left: 14px;
    padding: 5px 8px;
    color: var(--paper-bright);
    background: var(--ink);
    font-size: 0.62rem;
    font-weight: 850;
    letter-spacing: 0.13em;
  }

  .pet-copy {
    padding: 20px;
  }

  .pet-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
  }

  h3 {
    min-height: 2.1em;
    margin: 18px 0 8px;
    font-family: "Bodoni Moda Variable", Georgia, serif;
    font-size: clamp(1.8rem, 3vw, 2.6rem);
    letter-spacing: -0.055em;
    line-height: 0.96;
  }

  p {
    margin: 0;
    color: var(--muted);
    font-size: 0.75rem;
    font-weight: 750;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .palette {
    display: flex;
    gap: 5px;
    margin-top: 16px;
  }

  .palette span {
    width: 23px;
    height: 13px;
    border: 1px solid var(--ink);
    background: var(--swatch);
  }

  .pet-actions {
    display: flex;
    gap: 12px;
    align-items: end;
    justify-content: space-between;
    min-height: 38px;
    margin-top: 18px;
    padding-top: 14px;
    border-top: 2px solid var(--ink);
  }

  .open-link {
    font-size: 0.7rem;
    font-weight: 850;
    letter-spacing: 0.08em;
    text-decoration: underline;
    text-underline-offset: 4px;
    text-transform: uppercase;
  }

  .view-count {
    color: var(--muted);
    font-size: 0.66rem;
    font-weight: 760;
    white-space: nowrap;
  }

</style>
