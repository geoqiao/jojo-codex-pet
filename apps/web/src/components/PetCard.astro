---
import type { Locale, Pet } from "@jojo-codex-pet/catalog";
import { localize, route, ui } from "../lib/i18n";

interface Props {
  pet: Pet;
  locale: Locale;
}

const { pet, locale } = Astro.props;
const copy = ui[locale];
const name = localize(pet.name, locale);
const detailUrl = route(locale, `/pets/${pet.id}/`);
const initial = pet.name.en.replace(/^(The|Gold|Made)\s/i, "").charAt(0);
const cardImages = pet.image ? {
  small: pet.image.replace(/\.png$/, "-card-320.webp"),
  medium: pet.image.replace(/\.png$/, "-card-480.webp"),
  large: pet.image.replace(/\.png$/, "-card-640.webp"),
  fallback: pet.image.replace(/\.png$/, "-card.webp")
} : undefined;
const imageAlt = locale === "en"
  ? `${name}, Part ${pet.part} pixel Codex pet`
  : `${name}，JoJo 第 ${pet.part} 部像素 Codex 宠物`;
const paletteLabel = locale === "en" ? "Signature palette" : "标志配色";
---

<article
  class="pet-card"
  data-catalog-card
  data-pet-id={pet.id}
  data-part={`part-${String(pet.part).padStart(2, "0")}`}
  data-type={pet.type}
  data-status={pet.status}
>
  <a class="pet-card-link" href={detailUrl} aria-label={`${copy.open}: ${name}`} data-motion-hover={pet.id}>
    <div class="pet-card-content">
      <div class="pet-art motion-frame" style={`--part-accent: var(--part-${pet.part})`}>
        {cardImages ? (
          <img
            src={cardImages.fallback}
            class="motion-static"
            srcset={`${cardImages.small} 320w, ${cardImages.medium} 480w, ${cardImages.large} 640w`}
            sizes="(max-width: 640px) calc(45vw - 19.8px), (max-width: 775px) calc(46vw - 26.68px), (max-width: 840px) 330px, (max-width: 1178px) calc(30.6667vw - 31.28px), (max-width: 1180px) 330px, (max-width: 1512px) calc(23vw - 30.82px), 316.94px"
            alt={imageAlt}
            width="640"
            height="640"
            loading="lazy"
            decoding="async"
            style={`view-transition-name: pet-${pet.id}`}
          />
        ) : (
          <div class="planned-art" aria-hidden="true">
            <span>{initial}</span>
            <i>{String(pet.part).padStart(2, "0")}</i>
          </div>
        )}
        {cardImages && <span class="motion-layer" data-motion-layer aria-hidden="true"></span>}
        <span class="part-tag">PART {String(pet.part).padStart(2, "0")}</span>
      </div>
      <div class="pet-copy">
        <div class="pet-meta">
          {pet.status !== "released" && <span class="status-pill" data-status={pet.status}>{copy.status[pet.status]}</span>}
          <span class="type-pill">{copy.type[pet.type]}</span>
        </div>
        <h3>{name}</h3>
        <div class="pet-actions">
          {pet.palette && (
            <div class="palette" aria-label={paletteLabel}>
              {pet.palette.map((color) => <span style={`--swatch:${color}`} title={color}></span>)}
            </div>
          )}
          <span class="open-link" aria-hidden="true">↗</span>
        </div>
      </div>
    </div>
  </a>
</article>

<style define:vars={{
  "--part-1": "#d84b57",
  "--part-2": "#e69a38",
  "--part-3": "#7657d9",
  "--part-4": "#e553a4",
  "--part-5": "#d7b63f",
  "--part-6": "#54a58a",
  "--part-7": "#b56b3d",
  "--part-8": "#4ca7ba",
  "--part-9": "#6fbe5b"
}}>
  .pet-card {
    position: relative;
    min-width: 0;
    overflow: hidden;
    border: 3px solid var(--ink);
    background: var(--paper-bright);
    box-shadow: 6px 6px 0 var(--ink);
    transition: transform 160ms ease, box-shadow 160ms ease;
  }

  .pet-card:hover,
  .pet-card:focus-within {
    box-shadow: 9px 9px 0 var(--ink);
    transform: translate(-2px, -2px);
  }

  .pet-card:focus-within {
    outline: 4px solid var(--cyan);
    outline-offset: 4px;
  }

  .pet-card-link {
    display: block;
    color: inherit;
    cursor: pointer;
    text-decoration: none;
    touch-action: manipulation;
  }

  .pet-card-link:focus-visible {
    outline-color: transparent;
  }

  .pet-card[hidden] {
    display: none;
  }

  .pet-art {
    --motion-height: 89%;
    position: relative;
    display: grid;
    min-height: 290px;
    place-items: center;
    overflow: hidden;
    background:
      linear-gradient(135deg, rgb(255 255 255 / 44%) 0 12%, transparent 12% 74%, rgb(23 19 30 / 17%) 74%),
      var(--part-accent);
    border-bottom: 3px solid var(--ink);
  }

  .pet-art::after {
    position: absolute;
    right: -70px;
    bottom: -80px;
    width: 210px;
    height: 210px;
    content: "";
    border: 32px solid rgb(255 255 255 / 26%);
    border-radius: 50%;
  }

  .pet-art img {
    position: relative;
    z-index: 1;
    width: min(92%, 330px);
    height: 280px;
    object-fit: contain;
    image-rendering: pixelated;
    filter: drop-shadow(4px 5px 0 rgb(23 19 30 / 45%));
    transition: transform 180ms ease;
  }

  .pet-art .motion-layer {
    filter: drop-shadow(4px 5px 0 rgb(23 19 30 / 45%));
    transition: scale 180ms ease;
  }

  .pet-card:hover .pet-art img,
  .pet-card:focus-within .pet-art img {
    transform: scale(1.025);
  }

  .pet-card:hover .motion-layer,
  .pet-card:focus-within .motion-layer {
    scale: 1.025;
  }

  .planned-art {
    position: relative;
    z-index: 1;
    display: grid;
    width: 160px;
    height: 190px;
    place-items: center;
    color: var(--paper-bright);
    background: var(--ink);
    clip-path: polygon(20% 0, 84% 8%, 100% 48%, 76% 100%, 11% 91%, 0 42%);
  }

  .planned-art span {
    font-family: "Bodoni Moda Variable", Georgia, serif;
    font-size: 7rem;
    font-weight: 900;
    line-height: 0.8;
  }

  .planned-art i {
    position: absolute;
    right: 24px;
    bottom: 18px;
    color: var(--acid);
    font-size: 0.75rem;
    font-style: normal;
    font-weight: 850;
    letter-spacing: 0.16em;
  }

  .part-tag {
    position: absolute;
    z-index: 3;
    top: 14px;
    left: 14px;
    padding: 5px 8px;
    color: var(--paper-bright);
    background: var(--ink);
    font-size: 0.75rem;
    font-weight: 850;
    letter-spacing: 0.1em;
  }

  .pet-copy {
    padding: 20px;
  }

  .pet-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
  }

  h3 {
    min-height: 2.1em;
    margin: 18px 0 8px;
    font-family: "Bodoni Moda Variable", Georgia, serif;
    font-size: clamp(1.8rem, 3vw, 2.6rem);
    letter-spacing: -0.055em;
    line-height: 0.96;
  }

  .palette {
    display: flex;
    gap: 5px;
  }

  .palette span {
    width: 23px;
    height: 13px;
    border: 1px solid var(--ink);
    background: var(--swatch);
  }

  .pet-actions {
    display: flex;
    gap: 12px;
    align-items: center;
    justify-content: space-between;
    min-height: 38px;
    margin-top: 10px;
    padding-top: 14px;
    border-top: 2px solid var(--ink);
  }

  .open-link {
    margin-inline-start: auto;
    font-size: 1.25rem;
    font-weight: 850;
    line-height: 1;
  }

  /* Compact two-column cards: art, name and Part only; the rest lives on the detail page. */
  @media (max-width: 640px) {
    .pet-card {
      box-shadow: 4px 4px 0 var(--ink);
    }

    .pet-card:hover,
    .pet-card:focus-within {
      box-shadow: 4px 4px 0 var(--ink);
      transform: none;
    }

    .pet-art {
      --motion-height: 83%;
      min-height: 0;
      aspect-ratio: 1;
    }

    .pet-art img {
      width: 90%;
      height: auto;
      aspect-ratio: 1;
    }

    .part-tag {
      top: 8px;
      left: 8px;
      padding: 4px 6px;
      font-size: 0.75rem;
    }

    .pet-copy {
      padding: 10px 10px 12px;
    }

    .pet-meta,
    .pet-actions {
      display: none;
    }

    h3 {
      min-height: 2em;
      margin: 0;
      font-size: 1.25rem;
      letter-spacing: -0.04em;
    }
  }
</style>
