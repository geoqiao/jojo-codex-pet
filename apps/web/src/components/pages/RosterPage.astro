---
import { parts, pets, type Locale } from "@jojo-codex-pet/catalog";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PetThumb from "../PetThumb.astro";
import { localize, route, ui } from "../../lib/i18n";

interface Props { locale: Locale }
const { locale } = Astro.props;
const copy = ui[locale];
const content = locale === "en" ? {
  title: "Roster — JoJo Codex Pet",
  description: "The full list of 36 JoJo Codex pets, by Part, with each pet's type.",
  eyebrow: "Parts 1–9",
  heading: "EVERY PET, ONE LIST.",
  intro: "Every named character and Stand from Parts 1–9, and each one installs on its own.",
  pet: "Pet",
  identity: "Type",
  status: "Status",
  part9: "Part 9 has two pets while its story is still running."
} : {
  title: "名单 — JoJo Codex Pet",
  description: "36 只 JoJo Codex 宠物的完整名单，按篇章排列，并标明类型。",
  eyebrow: "第 1–9 部",
  heading: "36 只，一份名单。",
  intro: "第 1–9 部的所有具名角色与替身，每一只都可以单独安装。",
  pet: "宠物",
  identity: "类型",
  status: "状态",
  part9: "第 9 部仍在连载，目前只有两只宠物。"
};
---

<BaseLayout locale={locale} title={content.title} description={content.description} path="/roster/">
  <div class="shell">
    <header class="page-intro">
      <div><p class="eyebrow">{content.eyebrow}</p><h1 class="display">{content.heading}</h1></div>
      <p>{content.intro}</p>
    </header>

    <div class="roster-stack">
      {parts.map((part) => (
        <section class="roster-part">
          <header style={`--accent:${part.accent}`}>
            <span>{String(part.number).padStart(2, "0")}</span>
            <div><p>PART {part.number}</p><h2>{localize(part.title, locale)}</h2></div>
          </header>
          <table class="roster-table">
            <caption class="visually-hidden">{`${localize(part.title, locale)} ${content.pet}`}</caption>
            <thead>
              <tr class="roster-row roster-head">
                <th scope="col">#</th>
                <th scope="col">{content.pet}</th>
                <th scope="col">{content.identity}</th>
                <th scope="col">{content.status}</th>
              </tr>
            </thead>
            <tbody>
              {pets.filter((pet) => pet.part === part.number).map((pet, index) => (
                <tr class="roster-row" data-motion-hover={pet.id}>
                  <td class="roster-index">{String(index + 1).padStart(2, "0")}</td>
                  <td class="roster-name">
                    <PetThumb petId={pet.id} />
                    <div>
                      <a href={route(locale, `/pets/${pet.id}/`)}>{localize(pet.name, locale)}</a>
                      <code>{pet.id}</code>
                    </div>
                  </td>
                  <td class="roster-type">{copy.type[pet.type]} · {copy.role[pet.role]}</td>
                  <td class="roster-status"><span class="status-pill" data-status={pet.status}>{copy.status[pet.status]}</span></td>
                </tr>
              ))}
            </tbody>
          </table>
          {part.number === 9 && <p class="part-note">{content.part9}</p>}
        </section>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .roster-stack {
    display: grid;
    gap: 42px;
    min-width: 0;
  }

  .roster-part {
    min-width: 0;
    border: 3px solid var(--ink);
    background: var(--paper-bright);
    box-shadow: var(--shadow);
  }

  .roster-part > header {
    display: grid;
    grid-template-columns: 120px minmax(0, 1fr);
    min-height: 130px;
    color: var(--paper-bright);
    background: var(--ink);
  }

  .roster-part > header > span {
    display: grid;
    place-items: center;
    color: var(--ink);
    background: var(--accent);
    border-right: 3px solid var(--paper-bright);
    font-family: "Bodoni Moda Variable", Georgia, serif;
    font-size: 4.8rem;
    font-weight: 900;
  }

  .roster-part header div {
    display: grid;
    align-content: center;
    min-width: 0;
    padding: 18px 28px;
  }

  .roster-part header p {
    margin: 0 0 5px;
    color: var(--acid);
    font-size: 0.75rem;
    font-weight: 850;
    letter-spacing: 0.12em;
  }

  h2 {
    margin: 0;
    font-family: "Bodoni Moda Variable", Georgia, serif;
    font-size: clamp(2.3rem, 5vw, 4.7rem);
    letter-spacing: -0.05em;
    line-height: 0.9;
  }

  .roster-table {
    display: block;
    width: 100%;
    border-collapse: collapse;
    min-width: 0;
  }

  .roster-table thead,
  .roster-table tbody {
    display: block;
  }

  .roster-row {
    position: relative;
    display: grid;
    grid-template-columns: 48px minmax(240px, 1.5fr) minmax(180px, 0.8fr) auto;
    gap: 18px;
    align-items: center;
    min-height: 88px;
    padding: 14px 22px;
    border-top: 2px solid var(--ink);
  }

  .roster-row > * {
    min-width: 0;
    padding: 0;
    text-align: start;
  }

  .roster-head {
    min-height: 44px;
    padding-block: 9px;
    color: var(--paper-bright);
    background: var(--ink);
    font-size: 0.75rem;
    font-weight: 850;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .roster-head > th:first-child {
    color: #aaa2b3;
  }

  .roster-index {
    color: var(--muted);
    font-size: 0.75rem;
    font-weight: 800;
  }

  .roster-name {
    display: flex;
    gap: 14px;
    align-items: center;
    --thumb-height: 64px;
  }

  .roster-row > .roster-name a {
    font-family: "Bodoni Moda Variable", Georgia, serif;
    font-size: 1.7rem;
    font-weight: 760;
    letter-spacing: -0.03em;
  }

  :global(:lang(zh-CN)) .roster-row > .roster-name a {
    font-family: "Archivo Variable", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", "Noto Sans SC", sans-serif;
    font-weight: 800;
    letter-spacing: -0.01em;
  }

  /* The whole row opens the pet page. */
  .roster-name a::after {
    position: absolute;
    inset: 0;
    content: "";
  }

  .roster-row:not(.roster-head):hover {
    background: var(--acid);
  }

  .roster-name a:focus-visible {
    outline: none;
  }

  .roster-row:has(a:focus-visible) {
    outline: 3px solid var(--ink);
    outline-offset: -3px;
  }

  code {
    display: block;
    margin-top: 4px;
    color: var(--muted);
    font-size: 0.75rem;
    overflow-wrap: anywhere;
  }

  .roster-type {
    color: var(--muted);
    font-size: 0.75rem;
    font-weight: 750;
    text-transform: uppercase;
  }

  .part-note {
    margin: 0;
    padding: 18px 22px;
    border-top: 2px solid var(--ink);
    background: var(--acid);
    font-size: 0.875rem;
    font-weight: 760;
  }

  .roster-row.roster-head > th {
    grid-column: auto;
    justify-self: stretch;
    color: inherit;
    font-size: inherit;
    font-weight: inherit;
  }

  @media (max-width: 760px) {
    h2 {
      font-size: clamp(1.75rem, 8.8vw, 2.05rem);
    }

    .roster-row {
      grid-template-columns: 34px minmax(0, 1fr);
      gap: 10px;
      padding-inline: 14px;
    }

    .roster-type,
    .roster-status {
      grid-column: 2;
      justify-self: start;
    }

    .roster-head {
      grid-template-columns: 34px repeat(3, minmax(0, 1fr));
      gap: 8px;
    }

    .roster-head > th:nth-child(3),
    .roster-head > th:nth-child(4) {
      grid-column: auto;
    }
  }
</style>
