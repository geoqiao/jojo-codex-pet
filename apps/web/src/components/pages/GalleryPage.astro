---
import { pets, type Locale } from "@jojo-codex-pet/catalog";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PetCard from "../PetCard.astro";
import ViewCounts from "../ViewCounts.astro";
import { route } from "../../lib/i18n";

interface Props { locale: Locale }
const { locale } = Astro.props;
const pilot = pets.filter((pet) => pet.part === 3 && pet.status !== "planned");
const releasedCount = pets.filter((pet) => pet.status === "released").length;
const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  url: "https://pixelstand.pet/",
  name: "JoJo Codex Pet",
  description: "An unofficial, non-commercial JoJo-themed Codex pet gallery.",
  inLanguage: ["en", "zh-CN"]
};
const content = locale === "en" ? {
  title: "JoJo Codex Pet — V2 companions across every Part",
  description: "An unofficial, non-commercial JoJo-themed Codex pet gallery. Browse the locked 36-pet roster and the Part 3 Pilot Set.",
  overline: "Unofficial · non-commercial · ad-free",
  hero: "A BIZARRE LITTLE COMPANION.",
  intro: "This is an unofficial gallery of animated JoJo character and Stand companions for OpenAI Codex Desktop. Each named identity is rebuilt as an independent Codex Pet V2 companion; artwork ships only after it survives the quality gate.",
  installCta: "Install a released pet",
  locked: "Roster locked",
  parts: "Parts",
  contract: "V2 only",
  metrics: "Project metrics",
  pilotTitle: "The Part 3 Pilot Set",
  pilotNote: "All four Part 3 Pilot pets are released and independently installable.",
  allTitle: "The headline roster",
  allNote: `36 pets · ${releasedCount} installable · Parts 1–9`,
  filters: { all: "All", pilot: "Pilot", character: "Characters", stand: "Stands" },
  filterLabel: "Catalog filters",
  count: "pets shown"
} : {
  title: "JoJo Codex Pet — 横跨历代篇章的 V2 宠物",
  description: "非官方、非商业的 JoJo 主题 Codex 宠物目录，展示锁定的 36 只名单与第三部 Pilot 四只。",
  overline: "非官方 · 非商业 · 无广告",
  hero: "一只奇妙的小伙伴。",
  intro: "这是一个面向 OpenAI Codex Desktop 的非官方 JoJo 角色与替身动画宠物目录。每个具名身份都被分别制作成独立的 Codex Pet V2，宠物素材通过质量门后才正式发布。",
  installCta: "安装一只已发布宠物",
  locked: "名单已锁定",
  parts: "篇章",
  contract: "仅 V2",
  metrics: "项目数据",
  pilotTitle: "第三部 Pilot 合集",
  pilotNote: "第三部 Pilot 四只宠物均已发布，并可分别独立安装。",
  allTitle: "首发完整名单",
  allNote: `36 只 · ${releasedCount} 只可安装 · 第 1–9 部`,
  filters: { all: "全部", pilot: "Pilot", character: "角色", stand: "替身" },
  filterLabel: "宠物目录筛选",
  count: "只宠物"
};
---

<BaseLayout locale={locale} title={content.title} description={content.description} path="/" structuredData={structuredData}>
  <section class="hero">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">{content.overline}</p>
        <h1 class="display">{content.hero}</h1>
        <p class="hero-intro">{content.intro}</p>
        <a class="button hero-cta" href={route(locale, "/install/")} data-home-install-cta>{content.installCta} ↗</a>
      </div>
      <div class="hero-metrics" aria-label={content.metrics}>
        <div><strong>36</strong><span>{content.locked}</span></div>
        <div><strong>09</strong><span>{content.parts}</span></div>
        <div><strong>V2</strong><span>{content.contract}</span></div>
      </div>
      <div class="hero-slash" aria-hidden="true"><span>ORA</span><span>MUDA</span></div>
    </div>
  </section>

  <section class="shell catalog-section">
    <div class="section-title"><h2>{content.pilotTitle}</h2><span>{content.pilotNote}</span></div>
    <div class="pet-grid pilot-grid">
      {pilot.map((pet, index) => <PetCard pet={pet} locale={locale} priority={index < 2} />)}
    </div>
  </section>

  <section class="shell catalog-section" id="roster">
    <div class="section-title"><h2>{content.allTitle}</h2><span>{content.allNote}</span></div>
    <div class="filter-bar" aria-label={content.filterLabel}>
      <div class="filter-options">
        <button type="button" class="active" data-gallery-filter="all" aria-pressed="true" aria-controls="roster-grid">{content.filters.all}</button>
        <button type="button" data-gallery-filter="pilot" aria-pressed="false" aria-controls="roster-grid">{content.filters.pilot}</button>
        <button type="button" data-gallery-filter="character" aria-pressed="false" aria-controls="roster-grid">{content.filters.character}</button>
        <button type="button" data-gallery-filter="stand" aria-pressed="false" aria-controls="roster-grid">{content.filters.stand}</button>
        {[1,2,3,4,5,6,7,8,9].map((part) => <button type="button" data-gallery-filter={`part-${String(part).padStart(2, "0")}`} aria-pressed="false" aria-controls="roster-grid">P{part}</button>)}
      </div>
      <span aria-live="polite"><strong data-visible-count>36</strong> {content.count}</span>
    </div>
    <div class="pet-grid full-grid" id="roster-grid">
      {pets.map((pet) => <PetCard pet={pet} locale={locale} />)}
    </div>
  </section>
  <ViewCounts locale={locale} />
</BaseLayout>

<script>
  const filterButtons = [...document.querySelectorAll("[data-gallery-filter]")];
  const cards = [...document.querySelectorAll("#roster [data-catalog-card]")];
  const visibleCount = document.querySelector("[data-visible-count]");

  const applyFilter = (filter: string, syncUrl = true) => {
    let visible = 0;
    for (const card of cards) {
      const isPilot = filter === "pilot" && card.getAttribute("data-part") === "part-03" && card.getAttribute("data-status") !== "planned";
      const matches = filter === "all" || isPilot || card.getAttribute("data-part") === filter || card.getAttribute("data-type") === filter || card.getAttribute("data-status") === filter;
      card.toggleAttribute("hidden", !matches);
      if (matches) visible += 1;
    }
    if (visibleCount) visibleCount.textContent = String(visible);
    for (const button of filterButtons) {
      const isActive = button.getAttribute("data-gallery-filter") === filter;
      button.classList.toggle("active", isActive);
      button.setAttribute("aria-pressed", String(isActive));
    }

    if (syncUrl) {
      const url = new URL(window.location.href);
      if (filter === "all") {
        url.searchParams.delete("filter");
        url.searchParams.delete("part");
      } else if (/^part-0[1-9]$/.test(filter)) {
        url.searchParams.set("part", String(Number(filter.slice(-2))));
        url.searchParams.delete("filter");
      } else {
        url.searchParams.set("filter", filter);
        url.searchParams.delete("part");
      }
      window.history.replaceState({}, "", `${url.pathname}${url.search}${url.hash}`);
    }
  };

  for (const button of filterButtons) {
    button.addEventListener("click", () => applyFilter(button.getAttribute("data-gallery-filter") ?? "all"));
  }

  const params = new URLSearchParams(window.location.search);
  const part = params.get("part");
  const requestedFilter = params.get("filter") ?? (part && /^[1-9]$/.test(part) ? `part-${part.padStart(2, "0")}` : "all");
  const availableFilters = new Set(filterButtons.map((button) => button.getAttribute("data-gallery-filter")));
  applyFilter(availableFilters.has(requestedFilter) ? requestedFilter : "all", false);
</script>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    color: var(--paper-bright);
    background: var(--ink);
  }

  .hero::after {
    position: absolute;
    inset: auto -10% -40% 45%;
    height: 75%;
    content: "";
    background: var(--violet);
    transform: skewY(-11deg);
  }

  .hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(210px, 0.32fr);
    gap: 42px;
    min-height: 560px;
    align-items: center;
    padding-block: 40px 46px;
  }

  .hero-copy {
    position: relative;
    z-index: 2;
    min-width: 0;
  }

  .hero h1 {
    max-width: 1050px;
    font-size: clamp(4.4rem, 7vw, 7.2rem);
  }

  .hero-intro {
    max-width: 58ch;
    margin: 18px 0 0;
    font-size: clamp(1rem, 1.35vw, 1.2rem);
    font-weight: 600;
    line-height: 1.55;
  }

  .hero-cta {
    margin-top: 28px;
    background: var(--acid);
    box-shadow: 5px 5px 0 var(--paper-bright);
  }

  .hero-cta:hover {
    background: var(--cyan);
    box-shadow: 2px 2px 0 var(--paper-bright);
  }

  .hero-metrics {
    position: relative;
    z-index: 2;
    display: grid;
    align-self: center;
    margin-bottom: 0;
    border: 3px solid var(--paper-bright);
    background: var(--ink);
    box-shadow: 8px 8px 0 var(--acid);
  }

  .hero-metrics div {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding: 18px;
    border-bottom: 2px solid var(--paper-bright);
  }

  .hero-metrics div:last-child {
    border: 0;
  }

  .hero-metrics strong {
    font-family: "Bodoni Moda Variable", Georgia, serif;
    font-size: 3rem;
    line-height: 1;
  }

  .hero-metrics span {
    font-size: 0.63rem;
    font-weight: 850;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .hero-slash {
    position: absolute;
    z-index: 1;
    right: -5%;
    bottom: 12%;
    display: grid;
    color: rgb(255 255 255 / 8%);
    font-family: "Bodoni Moda Variable", Georgia, serif;
    font-size: clamp(7rem, 18vw, 18rem);
    font-weight: 900;
    line-height: 0.57;
    rotate: -8deg;
  }

  .catalog-section {
    padding-top: 46px;
  }

  .pet-grid {
    display: grid;
    gap: 26px;
  }

  .pilot-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .full-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .filter-bar {
    display: flex;
    gap: 20px;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 28px;
    padding: 12px;
    border: 3px solid var(--ink);
    background: var(--paper-bright);
  }

  .filter-options {
    display: flex;
    gap: 7px;
    overflow-x: auto;
  }

  .filter-options button {
    flex: 0 0 auto;
    min-height: 44px;
    padding: 7px 12px;
    border: 2px solid var(--ink);
    background: transparent;
    font-size: 0.67rem;
    font-weight: 850;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .filter-options button:hover,
  .filter-options button.active {
    background: var(--acid);
  }

  .filter-bar > span {
    flex: 0 0 auto;
    color: var(--muted);
    font-size: 0.72rem;
    font-weight: 760;
    text-transform: uppercase;
  }

  @media (max-width: 1180px) {
    .pilot-grid,
    .full-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 840px) {
    .hero-grid {
      grid-template-columns: 1fr;
      min-height: 0;
      padding-block: 52px;
    }

    .hero-metrics {
      grid-template-columns: repeat(3, 1fr);
      margin: 0;
    }

    .hero-metrics div {
      display: grid;
      border-right: 2px solid var(--paper-bright);
      border-bottom: 0;
    }

    .pilot-grid,
    .full-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .filter-bar {
      align-items: stretch;
      flex-direction: column;
    }
  }

  @media (max-width: 540px) {
    .hero h1 {
      font-size: clamp(3.1rem, 14vw, 4.3rem);
    }

    .pilot-grid,
    .full-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
