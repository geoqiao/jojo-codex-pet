---
import { pets, type Locale } from "@jojo-codex-pet/catalog";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PetCard from "../PetCard.astro";
import { localize, route } from "../../lib/i18n";
import { motionPosterUrl } from "../../lib/pet-motion";

interface Props { locale: Locale }
const { locale } = Astro.props;
const releasedCount = pets.filter((pet) => pet.status === "released").length;
const heroPet = pets.find((pet) => pet.id === "part-03-jotaro-kujo")!;
const heroName = localize(heroPet.name, locale);
const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  url: "https://pixelstand.pet/",
  name: "JoJo Codex Pet",
  inLanguage: ["en", "zh-CN"]
};
const content = locale === "en" ? {
  title: "JoJo Codex Pet — Animated companions across every Part",
  description: "An unofficial, non-commercial gallery of 36 animated JoJo pets for OpenAI Codex, across Parts 1–9. Each one has 9 actions and installs with one command.",
  overline: "Unofficial · non-commercial · ad-free",
  hero: "A BIZARRE LITTLE COMPANION.",
  intro: "This is an unofficial gallery of animated JoJo character and Stand companions for OpenAI Codex Desktop. Every pet idles, runs, waves, jumps and more in 9 animated actions, and installs with one command.",
  installCta: "Install a pet",
  metrics: "Gallery at a glance",
  metricLabels: ["Pets", "Parts", "Actions each"],
  heroPetLabel: `${heroName}, a pixel Codex pet from Part ${heroPet.part}`,
  pauseLabel: "Pause the animation",
  playLabel: "Play the animation",
  allTitle: "All 36 pets",
  allNote: `${releasedCount} ready to install · Parts 1–9`,
  hoverHint: " · hover a card to watch it move",
  filters: { all: "All", character: "Characters", stand: "Stands", part: (part: number) => `Part ${part}` },
  filterLabel: "Catalog filters",
  count: "pets shown"
} : {
  title: "JoJo Codex Pet — 横跨历代篇章的动画宠物",
  description: "非官方、非商业的 JoJo 主题 Codex 宠物目录：36 只动画宠物，横跨第一至第九部，每只 9 种动作，一条命令即可安装。",
  overline: "非官方 · 非商业 · 无广告",
  hero: "一只奇妙的小伙伴。",
  intro: "这是一个面向 OpenAI Codex Desktop 的非官方 JoJo 角色与替身动画宠物目录。每只宠物都有待机、奔跑、挥手、跳跃等 9 种动作，一条命令即可安装。",
  installCta: "安装一只宠物",
  metrics: "目录概览",
  metricLabels: ["只宠物", "个篇章", "种动作"],
  heroPetLabel: `${heroName}，JoJo 第 ${heroPet.part} 部像素 Codex 宠物`,
  pauseLabel: "暂停动画",
  playLabel: "播放动画",
  allTitle: "全部 36 只宠物",
  allNote: `${releasedCount} 只可安装 · 第 1–9 部`,
  hoverHint: " · 鼠标悬停卡片可看它动起来",
  filters: { all: "全部", character: "角色", stand: "替身", part: (part: number) => `第 ${part} 部` },
  filterLabel: "宠物目录筛选",
  count: "只宠物"
};
---

<BaseLayout locale={locale} title={content.title} description={content.description} path="/" structuredData={{ ...structuredData, description: content.description }}>
  <section class="hero">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">{content.overline.split(" · ").map((item, index, items) => <><span class="eyebrow-item">{item}</span>{index < items.length - 1 ? " · " : ""}</>)}</p>
        <h1 class="display">{content.hero}</h1>
        <p class="hero-intro">{content.intro}</p>
        <a class="button hero-cta" href={route(locale, "/install/")} data-home-install-cta>{content.installCta} ↗</a>
      </div>
      <div class="hero-pet" data-hero-pet={heroPet.id} data-play-label={content.playLabel} data-pause-label={content.pauseLabel}>
        <a class="hero-pet-link" href={route(locale, `/pets/${heroPet.id}/`)}>
          <span class="hero-pet-frame motion-frame">
            <img
              class="motion-static"
              src={motionPosterUrl(heroPet.id)}
              alt={content.heroPetLabel}
              width="192"
              height="208"
              fetchpriority="high"
              decoding="async"
            />
            <span class="motion-layer" data-motion-layer aria-hidden="true"></span>
          </span>
          <span class="hero-pet-name">{heroName} ↗</span>
        </a>
        <button class="hero-pet-toggle" type="button" data-motion-toggle hidden></button>
      </div>
      <div class="hero-metrics" aria-label={content.metrics}>
        <div><strong>{pets.length}</strong><span>{content.metricLabels[0]}</span></div>
        <div><strong>09</strong><span>{content.metricLabels[1]}</span></div>
        <div><strong>09</strong><span>{content.metricLabels[2]}</span></div>
      </div>
      <div class="hero-slash" aria-hidden="true"><span>ORA</span><span>MUDA</span></div>
    </div>
  </section>

  <section class="shell catalog-section" id="roster">
    <div class="section-title"><h2>{content.allTitle}</h2><span>{content.allNote}<span class="hover-hint">{content.hoverHint}</span></span></div>
    <div class="filter-bar" aria-label={content.filterLabel}>
      <div class="filter-options">
        <button type="button" class="active" data-gallery-filter="all" aria-pressed="true" aria-controls="roster-grid">{content.filters.all}</button>
        <button type="button" data-gallery-filter="character" aria-pressed="false" aria-controls="roster-grid">{content.filters.character}</button>
        <button type="button" data-gallery-filter="stand" aria-pressed="false" aria-controls="roster-grid">{content.filters.stand}</button>
        {[1,2,3,4,5,6,7,8,9].map((part) => <button type="button" data-gallery-filter={`part-${String(part).padStart(2, "0")}`} aria-pressed="false" aria-controls="roster-grid">{content.filters.part(part)}</button>)}
      </div>
      <span aria-live="polite"><strong data-visible-count>{pets.length}</strong> {content.count}</span>
    </div>
    <div class="pet-grid full-grid" id="roster-grid">
      {pets.map((pet) => <PetCard pet={pet} locale={locale} />)}
    </div>
  </section>
</BaseLayout>

<script>
  import { MotionPlayer, loadStrip, motionStripUrl, prefersReducedMotion } from "../../lib/pet-motion";

  // The poster is already on screen; the animation strips load after the page settles.
  const hero = document.querySelector<HTMLElement>("[data-hero-pet]");
  const layer = hero?.querySelector<HTMLElement>("[data-motion-layer]");
  const toggle = hero?.querySelector<HTMLButtonElement>("[data-motion-toggle]");
  const petId = hero?.dataset.heroPet;

  if (hero && layer && toggle && petId) {
    const player = new MotionPlayer(layer, petId, [{ state: "idle", loops: 3 }, { state: "waving", loops: 2 }]);
    const render = () => {
      const label = player.playing ? hero.dataset.pauseLabel : hero.dataset.playLabel;
      toggle.textContent = player.playing ? "❚❚" : "▶";
      toggle.setAttribute("aria-label", label ?? "");
      toggle.hidden = false;
    };
    const start = async () => {
      if (await player.play()) hero.classList.add("is-motion-active");
      render();
    };

    player.watchVisibility();
    toggle.addEventListener("click", () => {
      if (player.playing) {
        player.pause();
        render();
      } else {
        void start();
      }
    });
    const prepare = async () => {
      await Promise.all(["idle", "waving"].map((state) => loadStrip(motionStripUrl(petId, state))));
      if (prefersReducedMotion()) render();
      else await start();
    };
    const defer = () => (window.requestIdleCallback ? window.requestIdleCallback(() => void prepare()) : window.setTimeout(() => void prepare(), 200));
    if (document.readyState === "complete") defer();
    else window.addEventListener("load", defer, { once: true });
  }
</script>

<script>
  const filterButtons = [...document.querySelectorAll("[data-gallery-filter]")];
  const cards = [...document.querySelectorAll("#roster [data-catalog-card]")];
  const visibleCount = document.querySelector("[data-visible-count]");

  const applyFilter = (filter: string, syncUrl = true) => {
    let visible = 0;
    for (const card of cards) {
      const matches = filter === "all" || card.getAttribute("data-part") === filter || card.getAttribute("data-type") === filter || card.getAttribute("data-status") === filter;
      card.toggleAttribute("hidden", !matches);
      if (matches) visible += 1;
    }
    if (visibleCount) visibleCount.textContent = String(visible);
    for (const button of filterButtons) {
      const isActive = button.getAttribute("data-gallery-filter") === filter;
      button.classList.toggle("active", isActive);
      button.setAttribute("aria-pressed", String(isActive));
    }

    if (syncUrl) {
      const url = new URL(window.location.href);
      if (filter === "all") {
        url.searchParams.delete("filter");
        url.searchParams.delete("part");
      } else if (/^part-0[1-9]$/.test(filter)) {
        url.searchParams.set("part", String(Number(filter.slice(-2))));
        url.searchParams.delete("filter");
      } else {
        url.searchParams.set("filter", filter);
        url.searchParams.delete("part");
      }
      window.history.replaceState({}, "", `${url.pathname}${url.search}${url.hash}`);
    }
  };

  for (const button of filterButtons) {
    button.addEventListener("click", () => applyFilter(button.getAttribute("data-gallery-filter") ?? "all"));
  }

  const params = new URLSearchParams(window.location.search);
  const part = params.get("part");
  const requestedFilter = params.get("filter") ?? (part && /^[1-9]$/.test(part) ? `part-${part.padStart(2, "0")}` : "all");
  const availableFilters = new Set(filterButtons.map((button) => button.getAttribute("data-gallery-filter")));
  applyFilter(availableFilters.has(requestedFilter) ? requestedFilter : "all", false);
</script>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    color: var(--paper-bright);
    background: var(--ink);
  }

  .eyebrow-item {
    white-space: nowrap;
  }

  .hero::after {
    position: absolute;
    inset: auto -10% -40% 45%;
    height: 75%;
    content: "";
    background: var(--violet);
    transform: skewY(-11deg);
  }

  .hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 0.46fr);
    grid-template-areas:
      "copy pet"
      "metrics pet";
    gap: 32px 42px;
    align-items: center;
    padding-block: 40px 46px;
  }

  .hero-copy {
    position: relative;
    z-index: 2;
    grid-area: copy;
    min-width: 0;
  }

  .hero h1 {
    max-width: 1050px;
    font-size: clamp(4.4rem, 7vw, 7.2rem);
  }

  .hero-intro {
    max-width: 58ch;
    margin: 18px 0 0;
    font-size: clamp(1rem, 1.35vw, 1.2rem);
    font-weight: 600;
    line-height: 1.55;
  }

  .hero-cta {
    margin-top: 28px;
    background: var(--acid);
    box-shadow: 5px 5px 0 var(--paper-bright);
  }

  .hero-cta:hover {
    background: var(--cyan);
    box-shadow: 2px 2px 0 var(--paper-bright);
  }

  .hero-pet {
    position: relative;
    z-index: 2;
    display: grid;
    grid-area: pet;
    gap: 10px;
    justify-items: center;
    min-width: 0;
  }

  .hero-pet-link {
    display: grid;
    gap: 6px;
    justify-items: center;
    width: 100%;
    color: inherit;
    text-decoration: none;
  }

  .hero-pet-frame {
    --motion-height: 100%;
    width: min(100%, 440px);
    aspect-ratio: 192 / 208;
  }

  .hero-pet-frame img,
  .hero-pet-frame .motion-layer {
    filter: drop-shadow(8px 9px 0 rgb(23 19 30 / 45%));
  }

  .hero-pet-frame img {
    width: 100%;
    height: 100%;
  }

  .hero-pet-name {
    padding: 6px 10px;
    color: var(--ink);
    background: var(--acid);
    font-size: 0.75rem;
    font-weight: 850;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .hero-pet-link:hover .hero-pet-name {
    background: var(--cyan);
  }

  .hero-pet-toggle {
    position: absolute;
    z-index: 3;
    top: 0;
    right: 0;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 2px solid var(--paper-bright);
    color: var(--paper-bright);
    background: rgb(23 19 30 / 70%);
    font-size: 0.875rem;
    cursor: pointer;
  }

  .hero-pet-toggle[hidden] {
    display: none;
  }

  .hero-pet-toggle:hover {
    color: var(--ink);
    background: var(--acid);
  }

  .hero-metrics {
    position: relative;
    z-index: 2;
    display: grid;
    grid-area: metrics;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    max-width: 560px;
    border: 3px solid var(--paper-bright);
    background: var(--ink);
    box-shadow: 8px 8px 0 var(--acid);
  }

  .hero-metrics div {
    display: grid;
    gap: 2px;
    padding: 12px 16px;
    border-right: 2px solid var(--paper-bright);
  }

  .hero-metrics div:last-child {
    border: 0;
  }

  .hero-metrics strong {
    font-family: "Bodoni Moda Variable", Georgia, serif;
    font-size: 2.6rem;
    line-height: 1;
  }

  .hero-metrics span {
    font-size: 0.75rem;
    font-weight: 850;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .hero-slash {
    position: absolute;
    z-index: 1;
    right: -5%;
    bottom: 12%;
    display: grid;
    color: rgb(255 255 255 / 8%);
    font-family: "Bodoni Moda Variable", Georgia, serif;
    font-size: clamp(7rem, 18vw, 18rem);
    font-weight: 900;
    line-height: 0.57;
    rotate: -8deg;
  }

  .catalog-section {
    padding-top: 46px;
  }

  .pet-grid {
    display: grid;
    gap: 26px;
  }

  .full-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .filter-bar {
    display: flex;
    gap: 20px;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 28px;
    padding: 12px;
    border: 3px solid var(--ink);
    background: var(--paper-bright);
  }

  .filter-options {
    display: flex;
    gap: 7px;
    overflow-x: auto;
  }

  .filter-options button {
    flex: 0 0 auto;
    min-height: 44px;
    padding: 7px 12px;
    border: 2px solid var(--ink);
    background: transparent;
    font-size: 0.75rem;
    font-weight: 850;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .filter-options button:hover,
  .filter-options button.active {
    background: var(--acid);
  }

  .filter-bar > span {
    flex: 0 0 auto;
    color: var(--muted);
    font-size: 0.75rem;
    font-weight: 760;
    text-transform: uppercase;
  }

  @media (max-width: 1180px) {
    .full-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 840px) {
    .hero-grid {
      grid-template-columns: 1fr;
      grid-template-areas:
        "copy"
        "pet"
        "metrics";
      gap: 24px;
      padding-block: 28px 36px;
    }

    .hero-pet {
      width: min(58vw, 300px);
      justify-self: center;
    }

    .hero-pet-frame {
      width: 100%;
    }

    .hero-metrics {
      max-width: none;
    }

    .full-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .filter-bar {
      align-items: stretch;
      flex-direction: column;
    }
  }

  @media (max-width: 640px) {
    .hero h1 {
      font-size: clamp(3.1rem, 14vw, 4.3rem);
    }

    .full-grid {
      gap: 14px;
    }

    .hero-metrics strong {
      font-size: 2.2rem;
    }

    .hero-metrics div {
      padding-inline: 12px;
    }
  }
</style>
