---
import { parts, pets, type Locale } from "@jojo-codex-pet/catalog";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { localize } from "../../lib/i18n";
import { installCommandsFor, openInCodexUrlFor } from "../../lib/install-links";
import InstallActionTracking from "../InstallActionTracking.astro";

interface Props { locale: Locale }
const { locale } = Astro.props;
const releasedPets = pets.filter((pet) => pet.status === "released" && pet.packagePath);
const releasedPet = releasedPets[0]!;
const localePrefix = locale === "zh-CN" ? "/zh-CN" : "";
const petName = localize(releasedPet.name, locale);
const releasedPetPart = parts.find((part) => part.number === releasedPet.part)!;
const releasedPetImage = releasedPet.image?.replace(/\.png$/, "-card.webp");
const releasedPetImageAlt = locale === "en"
  ? `${petName}, Part ${releasedPet.part} pixel Codex pet`
  : `${petName}，JoJo 第 ${releasedPet.part} 部像素 Codex 宠物`;
const openInCodexUrl = openInCodexUrlFor({ nameEn: releasedPet.name.en, packagePath: releasedPet.packagePath! });
const commands = installCommandsFor(releasedPet.id);

const content = locale === "en" ? {
  title: "Install — JoJo Codex Pet",
  description: "Install validated JoJo Codex Pet v2 companions through official Codex, Bash, PowerShell, or npx flows.",
  eyebrow: "One pet per primary action",
  heading: "INSTALL ONLY WHAT YOU CHOOSE.",
  intro: "Choose any released pet. Every route installs only the selected Part-scoped pet and never silently adds a Stand Pair or an entire Part.",
  jump: "Choose a pet and install",
  pickerEyebrow: `${releasedPets.length} validated pets are live`,
  pickerTitle: "Choose your companion.",
  pickerBody: "The selection below controls Open in Codex and all three command installers.",
  pickerLabel: "Released pet",
  selected: "Current selection",
  actionPrivacy: "We count anonymous aggregate command-copy and Open in Codex actions. These totals show install intent—not completed installations or identifiable visitors.",
  availableTitle: "Browse every released pet",
  availableNote: "Each detail page includes the same pet-specific Codex deep link and verified command installers.",
  character: "Character",
  stand: "Stand",
  open: "Open in Codex",
  copy: "Copy",
  copied: "Copied",
  copyFailed: "Copy failed",
  methods: [
    { method: "codex", name: "Open in Codex", detail: "Uses the official Codex pet-install deep link and the selected hosted v2 spritesheet." },
    { method: "bash", name: "Bash", detail: "macOS and Linux installer with SHA-256 and manifest validation." },
    { method: "powershell", name: "PowerShell", detail: "Windows installer with the same package integrity checks." },
    { method: "npx", name: "npx", detail: "Cross-platform Node installer using the selected Part-scoped pet ID." }
  ],
  faqEyebrow: "Before you install",
  faqTitle: "Install FAQ",
  faqs: [
    ["Which method should I use?", "Use Open in Codex when your browser can hand the deep link to Codex. Bash is for macOS or Linux, PowerShell is for Windows, and npx works anywhere a current Node.js runtime is available."],
    ["Where do command installers put the pet?", "They write the selected runtime package to $CODEX_HOME/pets/<pet-id>. Without CODEX_HOME, the default is ~/.codex/pets/<pet-id>."],
    ["How does Codex discover it?", "After a command finishes, open Codex Settings → Pets, choose Refresh, then select the installed pet."],
    ["What gets verified?", "Bash, PowerShell, and npx download the checksum list, pet.json, and spritesheet, then verify SHA-256 plus the manifest ID and V2 contract before replacing runtime files."],
    ["What happens if I install the same pet again?", "A command installer refreshes the files under the same stable pet ID after validation. It does not create a duplicate or add another pet."]
  ]
} : {
  title: "安装 — JoJo Codex Pet",
  description: "通过 Codex 官方深链、Bash、PowerShell 或 npx 安装已验证的 JoJo Codex Pet V2。",
  eyebrow: "主操作一次只安装一只",
  heading: "只安装你选中的宠物。",
  intro: "选择任意已发布宠物。每条安装路径只安装当前篇章稳定 ID 对应的宠物，不会暗中附带替身配对或整部合集。",
  jump: "选择宠物并安装",
  pickerEyebrow: `${releasedPets.length} 只已验证宠物现已开放`,
  pickerTitle: "选择你的小伙伴。",
  pickerBody: "下方选择会同时控制 Codex 深链与三种命令行安装方式。",
  pickerLabel: "已发布宠物",
  selected: "当前选择",
  actionPrivacy: "站点只匿名汇总成功复制命令与点击“在 Codex 中打开”的次数。这些数据表示安装意图，不代表安装完成，也不识别访客。",
  availableTitle: "浏览全部已发布宠物",
  availableNote: "每个详情页都提供对应宠物的 Codex 深链与经过校验的命令行安装方式。",
  character: "角色",
  stand: "替身",
  open: "在 Codex 中打开",
  copy: "复制",
  copied: "已复制",
  copyFailed: "复制失败",
  methods: [
    { method: "codex", name: "在 Codex 中打开", detail: "使用 Codex 官方宠物安装深链与当前选择的托管 V2 图集。" },
    { method: "bash", name: "Bash", detail: "面向 macOS 与 Linux，校验 SHA-256 和宠物清单。" },
    { method: "powershell", name: "PowerShell", detail: "面向 Windows，执行相同的宠物包完整性校验。" },
    { method: "npx", name: "npx", detail: "使用当前篇章稳定宠物 ID 的跨平台 Node 安装器。" }
  ],
  faqEyebrow: "安装前须知",
  faqTitle: "安装常见问题",
  faqs: [
    ["应该选择哪种方式？", "浏览器能把官方深链交给 Codex 时，可使用“在 Codex 中打开”。macOS 或 Linux 使用 Bash，Windows 使用 PowerShell；安装了新版 Node.js 的平台也可使用 npx。"],
    ["命令行安装器会把宠物放在哪里？", "宠物会写入 $CODEX_HOME/pets/<pet-id>。未设置 CODEX_HOME 时，默认位置是 ~/.codex/pets/<pet-id>。"],
    ["怎样让 Codex 发现新宠物？", "命令执行完成后，打开 Codex Settings → Pets，点击 Refresh，再选择刚安装的宠物。"],
    ["安装器会校验什么？", "Bash、PowerShell 与 npx 会下载校验清单、pet.json 和 spritesheet，并在替换运行文件前校验 SHA-256、清单 ID 与 V2 合同。"],
    ["重复安装同一只宠物会怎样？", "命令行安装器通过校验后，会更新同一稳定宠物 ID 下的文件；不会创建重复宠物，也不会附带安装其他宠物。"]
  ]
};
---

<BaseLayout locale={locale} title={content.title} description={content.description} path="/install/">
  <div class="shell">
    <header class="page-intro install-intro">
      <div><p class="eyebrow">{content.eyebrow}</p><h1 class="display">{content.heading}</h1></div>
      <div class="intro-copy"><p>{content.intro}</p><a href="#choose-pet">{content.jump} ↓</a></div>
    </header>

    <section class="install-workbench" id="choose-pet" aria-labelledby="pet-picker-title">
      <header class="picker-card">
        <div class="picker-intro">
          <p class="eyebrow">{content.pickerEyebrow}</p>
          <h2 id="pet-picker-title">{content.pickerTitle}</h2>
          <p>{content.pickerBody}</p>
        </div>
        <div class="pet-preview" data-selected-pet-preview style={`--selected-accent:${releasedPetPart.accent}`}>
          <span class="preview-part" data-selected-pet-part>PART {String(releasedPet.part).padStart(2, "0")}</span>
          {releasedPetImage && (
            <img
              src={releasedPetImage}
              alt={releasedPetImageAlt}
              width="640"
              height="640"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              data-selected-pet-image
            />
          )}
          <strong data-selected-preview-name>{petName}</strong>
        </div>
        <div class="picker-control">
          <label for="released-pet-select">{content.pickerLabel}</label>
          <select id="released-pet-select" name="released-pet" autocomplete="off" data-pet-selector>
            {releasedPets.map((pet) => (
              <option
                value={pet.id}
                data-pet-name-en={pet.name.en}
                data-pet-name-localized={localize(pet.name, locale)}
                data-package-path={pet.packagePath}
                data-pet-part={pet.part}
                data-pet-accent={parts.find((part) => part.number === pet.part)?.accent}
                data-pet-image={pet.image?.replace(/\.png$/, "-card.webp")}
                data-pet-image-alt={locale === "en"
                  ? `${localize(pet.name, locale)}, Part ${pet.part} pixel Codex pet`
                  : `${localize(pet.name, locale)}，JoJo 第 ${pet.part} 部像素 Codex 宠物`}
              >
                {localize(pet.name, locale)} · Part {pet.part}
              </option>
            ))}
          </select>
          <p class="selected-pet" aria-live="polite">
            <span>{content.selected}</span>
            <strong data-selected-pet-name>{petName}</strong>
            <code data-selected-pet-id>{releasedPet.id}</code>
          </p>
          <p class="codex-method-label"><span>01</span> {content.methods[0].name}</p>
          <a
            class="button codex-action"
            href={openInCodexUrl}
            data-install-deeplink
            data-action-pet-id={releasedPet.id}
            data-action-method="codex"
            data-action-locale={locale}
          >
            {content.open} ↗
          </a>
        </div>
      </header>

      <div class="method-grid" id="install-methods">
        {content.methods.filter(({ method }) => method !== "codex").map(({ method, name, detail }, index) => {
          const command = method === "bash" ? commands.bash : method === "powershell" ? commands.powershell : commands.npx;
          return (
            <article>
              <span>0{index + 2}</span>
              <h2>{name}</h2>
              <p>{detail}</p>
              <div class="install-command">
                <code data-command-output={method}>{command}</code>
                <button
                  class="button"
                  type="button"
                  data-copy-command={command}
                  data-copy-label={content.copy}
                  data-copied-label={content.copied}
                  data-copy-failed-label={content.copyFailed}
                  data-action-pet-id={releasedPet.id}
                  data-action-method={method}
                  data-action-locale={locale}
                  aria-live="polite"
                >
                  {content.copy}
                </button>
              </div>
            </article>
          );
        })}
      </div>
      <p class="action-privacy">{content.actionPrivacy}</p>
    </section>

    <section class="released-section" aria-labelledby="released-pets-title">
      <header>
        <h2 id="released-pets-title">{content.availableTitle}</h2>
        <p>{content.availableNote}</p>
      </header>
      <div class="released-grid">
        {releasedPets.map((pet) => {
          const image = pet.image?.replace(/\.png$/, "-card-320.webp");
          const accent = parts.find((part) => part.number === pet.part)?.accent;
          const name = localize(pet.name, locale);
          const alt = locale === "en"
            ? `${name}, Part ${pet.part} pixel Codex pet`
            : `${name}，JoJo 第 ${pet.part} 部像素 Codex 宠物`;
          return (
            <a href={`${localePrefix}/pets/${pet.id}/`}>
              <span class="released-thumb" style={`--released-accent:${accent}`}>
                {image && <img src={image} alt={alt} width="320" height="320" loading="lazy" decoding="async" />}
              </span>
              <span class="released-copy">
                <small>PART {String(pet.part).padStart(2, "0")}</small>
                <strong>{name}</strong>
                <small>{pet.type === "character" ? content.character : content.stand} ↗</small>
              </span>
            </a>
          );
        })}
      </div>
    </section>

    <section class="faq-section" aria-labelledby="install-faq-title">
      <header><p class="eyebrow">{content.faqEyebrow}</p><h2 id="install-faq-title">{content.faqTitle}</h2></header>
      <div class="faq-list">
        {content.faqs.map(([question, answer], index) => (
          <details open={index === 0}>
            <summary>{question}</summary>
            <p>{answer}</p>
          </details>
        ))}
      </div>
    </section>
  </div>
  <InstallActionTracking />
</BaseLayout>

<script>
  import { installCommandsFor, openInCodexUrlFor } from "../../lib/install-links";

  const selector = document.querySelector<HTMLSelectElement>("[data-pet-selector]");

  const updateSelection = () => {
    const option = selector?.selectedOptions[0];
    const petId = option?.value;
    const petNameEn = option?.dataset.petNameEn;
    const petNameLocalized = option?.dataset.petNameLocalized;
    const packagePath = option?.dataset.packagePath;
    const petPart = option?.dataset.petPart;
    const petAccent = option?.dataset.petAccent;
    const petImage = option?.dataset.petImage;
    const petImageAlt = option?.dataset.petImageAlt;
    if (!petId || !petNameEn || !petNameLocalized || !packagePath) return;

    const openUrl = openInCodexUrlFor({ nameEn: petNameEn, packagePath });
    const commands = installCommandsFor(petId);

    const selectedName = document.querySelector<HTMLElement>("[data-selected-pet-name]");
    const selectedId = document.querySelector<HTMLElement>("[data-selected-pet-id]");
    if (selectedName) selectedName.textContent = petNameLocalized;
    if (selectedId) selectedId.textContent = petId;

    const preview = document.querySelector<HTMLElement>("[data-selected-pet-preview]");
    const previewName = document.querySelector<HTMLElement>("[data-selected-preview-name]");
    const previewPart = document.querySelector<HTMLElement>("[data-selected-pet-part]");
    const previewImage = document.querySelector<HTMLImageElement>("[data-selected-pet-image]");
    if (preview && petAccent) preview.style.setProperty("--selected-accent", petAccent);
    if (previewName) previewName.textContent = petNameLocalized;
    if (previewPart && petPart) previewPart.textContent = `PART ${petPart.padStart(2, "0")}`;
    if (previewImage && petImage) {
      previewImage.src = petImage;
      previewImage.alt = petImageAlt ?? petNameLocalized;
    }

    const deepLink = document.querySelector<HTMLAnchorElement>("[data-install-deeplink]");
    if (deepLink) {
      deepLink.href = openUrl;
      deepLink.dataset.actionPetId = petId;
    }

    for (const method of ["bash", "powershell", "npx"] as const) {
      const output = document.querySelector<HTMLElement>(`[data-command-output="${method}"]`);
      const button = document.querySelector<HTMLButtonElement>(`[data-action-method="${method}"]`);
      if (output) output.textContent = commands[method];
      if (button) {
        button.dataset.copyCommand = commands[method];
        button.dataset.actionPetId = petId;
      }
    }
  };

  selector?.addEventListener("change", updateSelection);
  updateSelection();
</script>

<style>
  .install-intro {
    grid-template-columns: minmax(0, 0.9fr) minmax(300px, 0.55fr);
    gap: clamp(28px, 5vw, 72px);
    padding: clamp(34px, 5vw, 58px) 0 30px;
  }

  .install-intro h1 {
    max-width: 760px;
    font-size: clamp(3.8rem, 6.8vw, 7rem);
  }

  .install-intro .intro-copy {
    display: grid;
    gap: 18px;
  }

  .install-intro .intro-copy a {
    width: fit-content;
    font-size: 0.72rem;
    font-weight: 850;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-underline-offset: 5px;
  }

  .install-workbench {
    scroll-margin-top: 130px;
  }

  .picker-card {
    display: grid;
    grid-template-areas: "intro preview control";
    grid-template-columns: minmax(230px, 0.72fr) minmax(220px, 0.46fr) minmax(330px, 0.72fr);
    gap: clamp(20px, 3vw, 42px);
    align-items: center;
    padding: clamp(22px, 3vw, 38px);
    color: var(--paper-bright);
    background: var(--violet);
    border: 3px solid var(--ink);
    box-shadow: var(--shadow);
  }

  .picker-card h2,
  .faq-section h2,
  .released-section h2 {
    margin: 0;
    font-family: "Bodoni Moda Variable", Georgia, serif;
    font-size: clamp(2.6rem, 4.4vw, 4.8rem);
    letter-spacing: -0.055em;
    line-height: 0.9;
  }

  .picker-intro {
    grid-area: intro;
    min-width: 0;
  }

  .picker-intro > p:last-child {
    max-width: 58ch;
    margin-bottom: 0;
    line-height: 1.6;
  }

  .pet-preview {
    position: relative;
    display: grid;
    grid-area: preview;
    min-height: 310px;
    place-items: center;
    overflow: hidden;
    color: var(--ink);
    background:
      linear-gradient(135deg, rgb(255 255 255 / 46%) 0 16%, transparent 16% 72%, rgb(23 19 30 / 16%) 72%),
      var(--selected-accent);
    border: 3px solid var(--ink);
    box-shadow: 7px 7px 0 var(--ink);
  }

  .pet-preview::after {
    position: absolute;
    right: -48px;
    bottom: -56px;
    width: 145px;
    height: 145px;
    content: "";
    border: 23px solid rgb(255 255 255 / 25%);
    border-radius: 50%;
  }

  .pet-preview img {
    position: relative;
    z-index: 1;
    width: min(92%, 260px);
    height: 250px;
    object-fit: contain;
    image-rendering: pixelated;
    filter: drop-shadow(5px 6px 0 rgb(23 19 30 / 40%));
  }

  .preview-part,
  .pet-preview > strong {
    position: absolute;
    z-index: 2;
    left: 12px;
    padding: 5px 8px;
    color: var(--paper-bright);
    background: var(--ink);
    font-size: 0.62rem;
    font-weight: 850;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .preview-part { top: 12px; }

  .pet-preview > strong {
    right: 12px;
    bottom: 12px;
    max-width: calc(100% - 24px);
    overflow-wrap: anywhere;
    text-align: center;
  }

  .picker-control {
    display: grid;
    gap: 10px;
    padding: 20px;
    color: var(--ink);
    background: var(--acid);
    border: 3px solid var(--ink);
    grid-area: control;
  }

  .picker-control label,
  .selected-pet span {
    font-size: 0.68rem;
    font-weight: 850;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .picker-control select {
    width: 100%;
    min-height: 50px;
    padding: 10px 42px 10px 12px;
    color: var(--ink);
    background: var(--paper-bright);
    border: 2px solid var(--ink);
    font-weight: 750;
    cursor: pointer;
  }

  .selected-pet {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 5px 14px;
    margin: 6px 0 0;
    padding-top: 12px;
    border-top: 2px solid var(--ink);
  }

  .selected-pet strong { text-align: right; }
  .selected-pet code { grid-column: 1 / -1; overflow-wrap: anywhere; font-size: 0.68rem; }

  .codex-method-label {
    display: flex;
    gap: 8px;
    margin: 8px 0 0;
    font-size: 0.68rem;
    font-weight: 850;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .codex-method-label span { color: var(--ink); }
  .codex-action { width: 100%; background: var(--paper-bright); }

  .method-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
    margin-top: 28px;
  }

  .method-grid article {
    display: flex;
    min-width: 0;
    padding: 26px;
    border: 3px solid var(--ink);
    background: var(--paper-bright);
    flex-direction: column;
  }

  .method-grid article > span { color: var(--ink); font-size: 0.72rem; font-weight: 850; }

  .method-grid h2 {
    min-height: 2em;
    margin: 18px 0;
    font-family: "Bodoni Moda Variable", Georgia, serif;
    font-size: 2.3rem;
    letter-spacing: -0.04em;
    line-height: 0.95;
  }

  .method-grid p { min-height: 7em; color: var(--muted); line-height: 1.55; }

  .install-command {
    display: grid;
    gap: 12px;
    margin-top: auto;
  }

  .install-command code {
    min-height: 92px;
    padding: 12px;
    overflow-wrap: anywhere;
    border: 2px solid var(--ink);
    background: var(--paper);
    font-size: 0.68rem;
    line-height: 1.5;
  }

  .method-grid .button { margin-top: auto; }

  .install-intro .intro-copy a:focus-visible,
  .picker-control select:focus-visible,
  .codex-action:focus-visible,
  .method-grid button:focus-visible,
  .faq-list summary:focus-visible,
  .released-grid a:focus-visible {
    outline: 3px solid var(--paper-bright);
    outline-offset: 2px;
    box-shadow: 0 0 0 6px var(--ink);
    transition: none;
  }

  .action-privacy {
    max-width: 76ch;
    margin: 18px 0 0;
    color: var(--muted);
    font-size: 0.76rem;
    font-weight: 650;
    line-height: 1.6;
  }

  .faq-section {
    display: grid;
    grid-template-columns: minmax(230px, 0.5fr) minmax(0, 1fr);
    gap: clamp(28px, 5vw, 72px);
    margin-top: 78px;
    padding-top: 38px;
    border-top: 3px solid var(--ink);
  }

  .faq-list {
    border-top: 2px solid var(--ink);
  }

  .faq-list details {
    padding: 18px 4px;
    border-bottom: 2px solid var(--ink);
  }

  .faq-list summary {
    min-height: 44px;
    font-weight: 820;
    line-height: 1.4;
    cursor: pointer;
  }

  .faq-list p {
    max-width: 70ch;
    margin: 10px 0 0;
    color: var(--muted);
    line-height: 1.65;
  }

  .released-section { margin-top: 78px; }

  .released-section > header {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(280px, 0.5fr);
    gap: 32px;
    align-items: end;
    margin-bottom: 24px;
  }

  .released-section header p { margin: 0; color: var(--muted); line-height: 1.6; }

  .released-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 3px solid var(--ink);
    border-left: 3px solid var(--ink);
  }

  .released-grid a {
    display: grid;
    grid-template-columns: 112px minmax(0, 1fr);
    min-height: 152px;
    color: var(--ink);
    background: var(--paper-bright);
    border-right: 3px solid var(--ink);
    border-bottom: 3px solid var(--ink);
    text-decoration: none;
  }

  .released-grid a:hover,
  .released-grid a:focus-visible { background: var(--acid); }

  .released-thumb {
    display: grid;
    min-width: 0;
    place-items: center;
    overflow: hidden;
    background: var(--released-accent);
    border-right: 3px solid var(--ink);
  }

  .released-thumb img {
    width: 104px;
    height: 112px;
    object-fit: contain;
    image-rendering: pixelated;
    transition: transform 160ms ease;
  }

  .released-grid a:hover .released-thumb img,
  .released-grid a:focus-visible .released-thumb img { transform: scale(1.06); }

