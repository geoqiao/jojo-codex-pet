---
import { parts, type Locale, type Pet } from "@jojo-codex-pet/catalog";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PetDetailContent from "../PetDetailContent.astro";
import ViewCounts from "../ViewCounts.astro";
import { localize, route, ui } from "../../lib/i18n";

interface Props { locale: Locale; pet: Pet }
const { locale, pet } = Astro.props;
const copy = ui[locale];
const name = localize(pet.name, locale);
const part = parts.find((item) => item.number === pet.part)!;
const partTitle = localize(part.title, locale);
const statusLabel = copy.status[pet.status];
const content = locale === "en" ? {
  title: `${name} — Part ${pet.part}: ${partTitle} Codex Pet`,
  description: `${name} is the Part ${pet.part} ${copy.role[pet.role].toLowerCase()} ${copy.type[pet.type].toLowerCase()} pet for ${partTitle}. Status: ${statusLabel}.`,
  imageAlt: `${name}, a pixel-art Codex pet from JoJo Part ${pet.part}`
} : {
  title: `${name} — JoJo 第 ${pet.part} 部《${partTitle}》Codex 宠物`,
  description: `${name}是 JoJo 第 ${pet.part} 部《${partTitle}》的${copy.role[pet.role]}${copy.type[pet.type]}宠物，当前状态：${statusLabel}。`,
  imageAlt: `${name}，JoJo 第 ${pet.part} 部像素 Codex 宠物`
};
const pageUrl = new URL(route(locale, `/pets/${pet.id}/`), Astro.site);
const galleryUrl = new URL(route(locale, "/"), Astro.site);
const partsUrl = new URL(route(locale, "/parts/"), Astro.site);
const imageUrl = pet.image ? new URL(pet.image, Astro.site) : new URL("/social/jojo-codex-pet-promo-v1.png", Astro.site);
const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: content.title,
  description: content.description,
  url: pageUrl.href,
  inLanguage: locale,
  primaryImageOfPage: {
    "@type": "ImageObject",
    url: imageUrl.href
  },
  isPartOf: {
    "@type": "WebSite",
    name: "JoJo Codex Pet",
    url: "https://pixelstand.pet/"
  },
  breadcrumb: {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: copy.nav.gallery, item: galleryUrl.href },
      { "@type": "ListItem", position: 2, name: copy.nav.parts, item: partsUrl.href },
      { "@type": "ListItem", position: 3, name, item: pageUrl.href }
    ]
  }
};
---

<BaseLayout
  locale={locale}
  title={content.title}
  description={content.description}
  path={`/pets/${pet.id}/`}
  image={pet.image}
  imageAlt={content.imageAlt}
  structuredData={structuredData}
>
  <div class="shell detail-shell">
    <nav class="breadcrumbs" aria-label={locale === "en" ? "Breadcrumb" : "面包屑导航"}>
      <ol>
        <li><a href={route(locale, "/")}>{copy.nav.gallery}</a></li>
        <li aria-hidden="true">›</li>
        <li><a href={route(locale, "/parts/")}>{copy.nav.parts}</a></li>
        <li aria-hidden="true">›</li>
        <li aria-current="page">{name}</li>
      </ol>
    </nav>
    <PetDetailContent locale={locale} pet={pet} />
  </div>
  <ViewCounts locale={locale} incrementId={pet.id} />
</BaseLayout>

<style>
  .detail-shell { padding-top: 24px; }

  .breadcrumbs {
    margin-bottom: 18px;
    font-size: 0.72rem;
    font-weight: 760;
  }

  .breadcrumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    align-items: center;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .breadcrumbs a { text-underline-offset: 4px; }

  .breadcrumbs li[aria-current="page"] {
    color: var(--muted);
  }

</style>
