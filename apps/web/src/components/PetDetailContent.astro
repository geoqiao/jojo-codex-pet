---
import { parts, pets, type Locale, type Pet } from "@jojo-codex-pet/catalog";
import { petProfiles } from "../content/petProfiles";
import { localize, route, ui } from "../lib/i18n";
import { installCommandsFor, openInCodexUrlFor, packageUrlFor } from "../lib/install-links";
import { motionLabels, motionStates } from "../lib/pet-motion";
import InstallActionTracking from "./InstallActionTracking.astro";

interface Props { locale: Locale; pet: Pet }
const { locale, pet } = Astro.props;
const copy = ui[locale];
const name = localize(pet.name, locale);
const isReview = pet.status === "pilot-review" || pet.status === "wave-review";
const part = parts.find((item) => item.number === pet.part)!;
const partTitle = localize(part.title, locale);
const displayImage = pet.image?.replace(/\.png$/, "-card.webp");
const hasMotion = pet.status === "released" && Boolean(displayImage);
const imageAlt = locale === "en"
  ? `${name}, Part ${pet.part} pixel Codex pet`
  : `${name}，JoJo 第 ${pet.part} 部像素 Codex 宠物`;
const related = [pet.ownerId, ...(pet.pairIds ?? [])].flatMap((id) => {
  if (!id) return [];
  const match = pets.find((item) => item.id === id);
  return match ? [match] : [];
});
const lineageOwnerId = pet.type === "stand" ? pet.ownerId : pet.id;
const lineage = lineageOwnerId
  ? pets
      .filter((item) => item.type === "stand" && item.ownerId === lineageOwnerId && item.lineageStage !== undefined)
      .sort((left, right) => left.lineageStage! - right.lineageStage!)
  : [];
const profile = petProfiles[pet.id];
const profileSections = profile ? [
  { key: "about", section: profile.about },
  { key: "animationQa", section: profile.animationQa },
  { key: "packageCompatibility", section: profile.packageCompatibility }
] : [];
const packageUrl = pet.packagePath ? packageUrlFor(pet.packagePath) : undefined;
const pagePath = route(locale, `/pets/${pet.id}/`);
const openInCodexUrl = pet.packagePath ? openInCodexUrlFor({ nameEn: pet.name.en, packagePath: pet.packagePath }) : undefined;
const commands = packageUrl ? installCommandsFor(pet.id) : undefined;
const installCommands = commands ? [
  { method: "bash", label: "Bash · macOS / Linux", command: commands.bash },
  { method: "powershell", label: "PowerShell · Windows", command: commands.powershell },
  { method: "npx", label: `npx · ${locale === "en" ? "cross-platform" : "跨平台"}`, command: commands.npx }
] : [];
const content = locale === "en" ? {
  identity: "Pet ID",
  relationship: "Stand relationship",
  lineage: "Stand form lineage",
  lineageHelp: "Browse each independently installable animated Codex pet in story order.",
  lineageAnchor: (itemName: string) => `${itemName} — animated Codex pet`,
  ability: "Ability modes inside this pet",
  palette: "Signature palette",
  source: "Source",
  install: "Install this pet",
  installAnchor: "Install this pet ↓",
  productNote: "A free, unofficial animated pet for the Codex desktop app—not a standalone mobile app. The preview above is the released pixel artwork.",
  codexSupport: "Requires the Codex desktop app with Pets support. If the codex:// link does not open, use Other install methods below.",
  afterInstallLabel: "After install",
  afterInstall: "open Codex Settings > Pets, select Refresh, then choose the pet.",
  otherMethods: "Other install methods",
  developer: "developers",
  desktopTransfer: "On a phone? Copy this pet page link and open it on your computer to continue. The install actions remain available here when your Codex desktop app is ready.",
  copyPageLink: "Copy page link",
  pageLinkCopied: "Link copied",
  pageLinkCopyFailed: "Copy failed",
  pending: "This pet is not ready yet. Installation opens once its animations are finished.",
  reviewPending: "This pet is in final review. Installation opens once it is approved.",
  ready: "Installs only this pet, with all 9 animations. Use the Codex app link, or pick another method below.",
  overview: `${name} is the ${copy.role[pet.role].toLowerCase()} ${copy.type[pet.type].toLowerCase()} entry for Part ${pet.part}, ${partTitle}, one of 36 JoJo pets.`,
  released: `${name} is ready to install and includes all 9 animations.`,
  review: `${name} is in final review and cannot be installed yet.`,
  planned: `${name} is planned. Its artwork and animations are not published yet.`,
  openInCodex: "Open in Codex",
  motionLabel: "Animation preview",
  motionNow: "Now showing",
  motionStates: "Animation state",
  motionPause: "Pause",
  motionPlay: "Play",
  download: "Package files",
  methodsLabel: "Available install methods",
  methods: ["Codex app", "Bash", "PowerShell", "npx"],
  profileLabel: "Pet dossier",
  copy: "Copy",
  copied: "Copied",
  copyFailed: "Copy failed"
} : {
  identity: "宠物 ID",
  relationship: "替身关系",
  lineage: "替身形态系列",
  lineageHelp: "按故事顺序浏览每只可独立安装的像素动画 Codex 宠物。",
  lineageAnchor: (itemName: string) => `${itemName} — 像素动画 Codex 宠物`,
  ability: "包含在本宠物中的能力模式",
  palette: "标志配色",
  source: "来源",
  install: "安装这只宠物",
  installAnchor: "安装这只宠物 ↓",
  productNote: "这是给 Codex 桌面应用使用的免费、非官方动画宠物，不是独立手机应用。上方预览就是已发布的像素素材。",
  codexSupport: "需要支持 Pets 的 Codex 桌面应用。如果 codex:// 深链没有打开，请使用下方的“其他安装方式”。",
  afterInstallLabel: "安装后",
  afterInstall: "打开 Codex Settings > Pets，选择 Refresh，然后选择这只宠物。",
  otherMethods: "其他安装方式",
  developer: "开发者辅助",
  desktopTransfer: "手机上操作？复制这只宠物的页面链接，在电脑上继续。准备好支持 Pets 的 Codex 桌面应用后，这里的安装入口仍然可用。",
  copyPageLink: "复制页面链接",
  pageLinkCopied: "链接已复制",
  pageLinkCopyFailed: "复制失败",
  pending: "这只宠物还没有准备好。动画完成后才会开放安装。",
  reviewPending: "这只宠物正在做最终审核。通过后即可安装。",
  ready: "只安装这只宠物，包含全部 9 种动作。可使用 Codex 应用链接，或选择下方其他安装方式。",
  overview: `${name}是 JoJo 第 ${pet.part} 部《${partTitle}》的${copy.role[pet.role]}${copy.type[pet.type]}宠物，36 只 JoJo 宠物之一。`,
  released: `${name}可以安装，包含全部 9 种动作。`,
  review: `${name}正在做最终审核，暂时不能安装。`,
  planned: `${name}在计划中，美术与动画尚未发布。`,
  openInCodex: "在 Codex 中打开",
  motionLabel: "动画预览",
  motionNow: "当前动作",
  motionStates: "动画状态",
  motionPause: "暂停",
  motionPlay: "播放",
  download: "宠物包文件",
  methodsLabel: "可用安装方式",
  methods: ["Codex 应用", "Bash", "PowerShell", "npx"],
  profileLabel: "宠物档案",
  copy: "复制",
  copied: "已复制",
  copyFailed: "复制失败"
};
---

<div class="detail-grid">
  <div class="detail-side" data-pet-motion={hasMotion ? pet.id : undefined}>
    <div class="detail-art" style={`--accent:${part.accent}`}>
      {displayImage ? (
        <img
          class="motion-static"
          src={displayImage}
          alt={imageAlt}
          width="640"
          height="640"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          style={`view-transition-name: pet-${pet.id}`}
        />
      ) : (
        <div class="planned-sigil" aria-hidden="true"><span>{String(pet.part).padStart(2, "0")}</span><i>{pet.type === "character" ? "C" : "S"}</i></div>
      )}
      {hasMotion && <span class="motion-layer" data-motion-layer aria-hidden="true"></span>}
      <span class="detail-part">PART {String(pet.part).padStart(2, "0")}</span>
      {pet.status === "released" && packageUrl && openInCodexUrl && (
        <div class="detail-art-actions" role="group" aria-label={content.install}>
          <a class="quick-methods-link" href="#install-this-pet">{content.installAnchor}</a>
        </div>
      )}
    </div>
    {hasMotion && (
      <section class="motion-controls" data-motion-controls aria-label={content.motionLabel} hidden>
        <p class="motion-now" aria-live="polite" aria-atomic="true">
          <span>{content.motionNow}</span>
          <strong data-motion-now>{motionLabels[locale].idle}</strong>
        </p>
        <div class="motion-states" role="group" aria-label={content.motionStates}>
          {motionStates.map((state, index) => (
            <button type="button" aria-pressed={index === 0 ? "true" : "false"} data-motion-state={state.id} data-motion-label={motionLabels[locale][state.id]}>
              {motionLabels[locale][state.id]}
            </button>
          ))}
        </div>
        <button class="motion-play" type="button" data-motion-play data-pause-label={content.motionPause} data-play-label={content.motionPlay}>{content.motionPause}</button>
      </section>
    )}
    <div class="pet-summary">
      <p class="part-title">{localize(part.title, locale)} · {copy.role[pet.role]}</p>
      <p class="pet-product-note">{content.productNote}</p>
      <p class="pet-overview">{content.overview}</p>
      <p class="status-note">{pet.status === "released" ? content.released : isReview ? content.review : content.planned}</p>
    </div>
  </div>
  <div class="detail-copy">
    <div class="detail-heading">
      <div class="detail-pills"><span class="status-pill" data-status={pet.status}>{copy.status[pet.status]}</span><span class="type-pill">{copy.type[pet.type]}</span></div>
      <h1>{name}</h1>
    </div>
    <section class="install-box" id="install-this-pet">
      <div class="install-heading">
        <h2>{content.install}</h2>
        {pet.status === "released" && packageUrl && (
          <ul class="install-method-overview" aria-label={content.methodsLabel}>
            {content.methods.map((method) => <li>{method}</li>)}
          </ul>
        )}
      </div>
      {pet.status === "released" && packageUrl && openInCodexUrl ? (
        <>
          <p>{content.ready}</p>
          <div class="install-primary">
            <a
              class="button"
              href={openInCodexUrl}
              aria-describedby="detail-codex-support"
              data-install-deeplink
              data-action-pet-id={pet.id}
              data-action-method="codex"
              data-action-locale={locale}
            >
              {content.openInCodex} ↗
            </a>
            <a class="package-link" href={`${packageUrl}/pet.json`}>{content.download} <span>({content.developer})</span> ↗</a>
          </div>
          <p class="install-support" id="detail-codex-support">{content.codexSupport}</p>
          <p class="after-install-note"><strong>{content.afterInstallLabel}</strong> {content.afterInstall}</p>
          <div class="page-link-transfer">
            <p>{content.desktopTransfer}</p>
            <button
              class="page-link-button"
              type="button"
              data-copy-page-link={pagePath}
              data-page-link-copy-label={content.copyPageLink}
              data-page-link-copied-label={content.pageLinkCopied}
              data-page-link-copy-failed-label={content.pageLinkCopyFailed}
              aria-live="polite"
              aria-atomic="true"
            >
              {content.copyPageLink}
            </button>
          </div>
          <details class="other-methods">
            <summary>{content.otherMethods}</summary>
            <div class="command-list">
              {installCommands.map(({ method, label, command }) => (
                <div class="command-row">
                  <span>{label}</span>
                  <code>{command}</code>
                  <button
                    type="button"
                    data-copy-command={command}
                    data-copy-label={content.copy}
                    data-copied-label={content.copied}
                    data-copy-failed-label={content.copyFailed}
                    data-action-pet-id={pet.id}
                    data-action-method={method}
                    data-action-locale={locale}
                    aria-live="polite"
                    aria-atomic="true"
                  >
                    {content.copy}
                  </button>
                </div>
              ))}
            </div>
          </details>
        </>
      ) : (
        <><p>{isReview ? content.reviewPending : content.pending}</p><button class="button" type="button" disabled aria-disabled="true">{isReview ? copy.reviewNotInstallable : copy.notInstallable}</button></>
      )}
    </section>
    <dl>
      <div><dt>{content.identity}</dt><dd><code>{pet.id}</code></dd></div>
      {related.length > 0 && (
        <div>
          <dt>{content.relationship}</dt>
          <dd data-relationship-links>{related.map((item, index) => <><a href={route(locale, `/pets/${item.id}/`)}>{localize(item.name, locale)}</a>{index < related.length - 1 ? " · " : ""}</>)}</dd>
        </div>
      )}
      {pet.abilityModes && <div><dt>{content.ability}</dt><dd>{pet.abilityModes.map((mode) => localize(mode, locale)).join(" · ")}</dd></div>}
      {pet.palette && <div><dt>{content.palette}</dt><dd class="detail-palette">{pet.palette.map((color) => <span style={`--swatch:${color}`}><i>{color}</i></span>)}</dd></div>}
      <div><dt>{content.source}</dt><dd><a href={pet.source}>geoqiao/jojo-codex-pet ↗</a></dd></div>
    </dl>
    {lineage.length > 1 && (
      <nav class="lineage-nav" data-stand-lineage={lineageOwnerId} aria-labelledby={`lineage-title-${pet.id}`}>
        <h2 id={`lineage-title-${pet.id}`}>{content.lineage}</h2>
        <p>{content.lineageHelp}</p>
        <ol>
          {lineage.map((item, index) => (
            <li>
              <a
                href={route(locale, `/pets/${item.id}/`)}
                aria-current={item.id === pet.id ? "page" : undefined}
              >
                {content.lineageAnchor(localize(item.name, locale))}
              </a>
              {index < lineage.length - 1 && <span aria-hidden="true">→</span>}
            </li>
          ))}
        </ol>
      </nav>
    )}
  </div>
</div>
{profile && (
  <section class="editorial-profile" data-editorial-profile={pet.id} aria-label={locale === "en" ? "Pet profile" : "宠物资料"}>
    <p class="profile-label">{content.profileLabel}</p>
    <div class="profile-grid">
      {profileSections.map(({ key, section }) => (
        <article data-profile-section={key}>
          <h2>{section.title[locale]}</h2>
          <p>{section.body[locale]}</p>
        </article>
      ))}
    </div>
  </section>
)}
<InstallActionTracking />

<script>
  import { MotionPlayer, loadStrip, motionStripUrl, prefersReducedMotion } from "../lib/pet-motion";

  const root = document.querySelector<HTMLElement>("[data-pet-motion]");
  const stage = root?.querySelector<HTMLElement>(".detail-art");
  const layer = root?.querySelector<HTMLElement>("[data-motion-layer]");
  const controls = root?.querySelector<HTMLElement>("[data-motion-controls]");
  const playButton = root?.querySelector<HTMLButtonElement>("[data-motion-play]");
  const now = root?.querySelector<HTMLElement>("[data-motion-now]");
  const petId = root?.dataset.petMotion;

  if (stage && layer && controls && playButton && now && petId) {
    const buttons = [...controls.querySelectorAll<HTMLButtonElement>("[data-motion-state]")];
    const player = new MotionPlayer(layer, petId, [{ state: "idle" }]);
    player.watchVisibility();

    const renderPlay = () => {
      playButton.textContent = (player.playing ? playButton.dataset.pauseLabel : playButton.dataset.playLabel) ?? "";
    };
    const activate = (ready: boolean) => {
      if (ready) stage.classList.add("is-motion-active");
      return ready;
    };

    for (const button of buttons) {
      button.addEventListener("click", async () => {
        const state = button.dataset.motionState!;
        if (!activate(await player.set([{ state }]))) return;
        for (const other of buttons) other.setAttribute("aria-pressed", String(other === button));
        now.textContent = button.dataset.motionLabel ?? state;
      });
      const prefetch = () => void loadStrip(motionStripUrl(petId, button.dataset.motionState!));
      button.addEventListener("pointerenter", prefetch);
      button.addEventListener("focus", prefetch);
    }

    playButton.addEventListener("click", async () => {
      if (player.playing) player.pause();
      else activate(await player.play());
      renderPlay();
    });

    // The static art stays until the idle strip is ready; reduced-motion visitors start paused.
    const start = async () => {
      if (!(await loadStrip(motionStripUrl(petId, "idle")))) return;
      controls.hidden = false;
      if (!prefersReducedMotion()) activate(await player.play());
      renderPlay();
    };
    const defer = () => (window.requestIdleCallback ? window.requestIdleCallback(() => void start()) : window.setTimeout(() => void start(), 200));
    if (document.readyState === "complete") defer();
    else window.addEventListener("load", defer, { once: true });
  }
</script>

<style>
  .detail-grid {
    display: grid;
    grid-template-columns: minmax(300px, 0.7fr) minmax(0, 1fr);
    align-items: stretch;
    border: 3px solid var(--ink);
    background: var(--paper-bright);
    box-shadow: var(--shadow);
  }

  .detail-side {
    display: grid;
    grid-template-rows: minmax(560px, 1fr) auto auto;
    min-width: 0;
    border-right: 3px solid var(--ink);
  }

  .detail-art {
    display: grid;
    position: relative;
    container-type: inline-size;
    height: 100%;
    min-height: 560px;
    place-items: center;
    overflow: hidden;
    background:
      linear-gradient(140deg, rgb(255 255 255 / 38%) 0 14%, transparent 14% 68%, rgb(23 19 30 / 18%) 68%),
      var(--accent);
    border-bottom: 3px solid var(--ink);
  }

  .detail-art::before {
    position: absolute;
    width: 78%;
    aspect-ratio: 1;
    content: "";
    border: 34px solid rgb(255 255 255 / 24%);
    border-radius: 50%;
    rotate: -14deg;
  }

  .detail-art img {
    position: relative;
    z-index: 1;
    width: 88%;
    height: 510px;
    object-fit: contain;
    image-rendering: pixelated;
    filter: drop-shadow(8px 9px 0 rgb(23 19 30 / 42%));
  }

  .detail-art .motion-layer {
    height: min(81cqw, 469px);
    filter: drop-shadow(8px 9px 0 rgb(23 19 30 / 42%));
  }

  .motion-controls {
    display: grid;
    gap: 12px;
    padding: 16px 20px 18px;
    border-bottom: 3px solid var(--ink);
    background: var(--paper);
  }

  .motion-controls[hidden] {
    display: none;
  }

  .motion-now {
    display: flex;
    gap: 10px;
    align-items: baseline;
    margin: 0;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .motion-now strong {
    font-family: "Bodoni Moda Variable", Georgia, serif;
    font-size: 1.5rem;
    letter-spacing: -0.02em;
    text-transform: none;
  }

  .motion-states {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
  }

  .motion-states button,
  .motion-play {
    min-height: 44px;
    padding: 6px 8px;
    border: 2px solid var(--ink);
    color: var(--ink);
    background: var(--paper-bright);
    font-size: 0.75rem;
    font-weight: 850;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .motion-states button:hover,
  .motion-play:hover {
    background: var(--acid);
  }

  .motion-states button[aria-pressed="true"] {
    color: var(--paper-bright);
    background: var(--ink);
  }

  .motion-play {
    justify-self: start;
    min-width: 120px;
  }

  .detail-part {
    position: absolute;
    z-index: 2;
    top: 24px;
    left: 24px;
    padding: 7px 11px;
    color: var(--paper-bright);
    background: var(--ink);
    font-size: 0.75rem;
    font-weight: 850;
    letter-spacing: 0.13em;
  }

  .detail-art-actions {
    position: absolute;
    z-index: 3;
    right: 24px;
    bottom: 24px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: end;
  }

  .quick-methods-link {
    min-height: 44px;
    padding: 10px 12px;
    color: var(--paper-bright);
    background: var(--ink);
    font-size: 0.75rem;
    font-weight: 850;
    letter-spacing: 0.08em;
    text-align: right;
    text-underline-offset: 3px;
    text-transform: uppercase;
  }

  .planned-sigil {
    position: relative;
    z-index: 1;
    display: grid;
    width: 250px;
    height: 310px;
    place-items: center;
    color: var(--paper-bright);
    background: var(--ink);
    clip-path: polygon(16% 0, 86% 7%, 100% 52%, 74% 100%, 7% 90%, 0 35%);
  }

  .planned-sigil span {
    font-family: "Bodoni Moda Variable", Georgia, serif;
    font-size: 8rem;
    font-weight: 900;
  }

  .planned-sigil i {
    position: absolute;
    right: 32px;
    bottom: 26px;
    color: var(--acid);
    font-style: normal;
    font-weight: 900;
  }

  .detail-copy { min-width: 0; padding: clamp(28px, 3.8vw, 54px); }
  .detail-pills { display: flex; gap: 8px; }

  h1 {
    margin: 20px 0 14px;
    font-family: "Bodoni Moda Variable", Georgia, serif;
    font-size: clamp(4rem, 7.2vw, 7.4rem);
    letter-spacing: -0.07em;
    line-height: 0.92;
  }

  .part-title {
    margin: 0;
    color: var(--muted);
    font-size: 0.78rem;
    font-weight: 850;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .pet-overview {
    max-width: 66ch;
    margin: 14px 0 0;
    color: var(--muted);
    font-size: 0.95rem;
    font-weight: 620;
    line-height: 1.65;
  }

  .status-note {
    margin: 18px 0 0;
    padding: 11px 14px;
    border: 2px solid var(--ink);
    background: var(--acid);
    font-weight: 720;
  }

  .pet-summary {
    padding: 22px 24px 24px;
    background: var(--paper-bright);
  }

  .editorial-profile {
    margin-top: clamp(28px, 4vw, 48px);
    border: 3px solid var(--ink);
    background: var(--ink);
    box-shadow: var(--shadow);
  }

  .profile-label {
    margin: 0;
    padding: 12px 16px;
    color: var(--acid);
    font-size: 0.75rem;
    font-weight: 850;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .profile-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 3px;
    background: var(--ink);
  }

  .editorial-profile article {
    min-width: 0;
    padding: 22px 24px 24px;
    border-top: 5px solid var(--violet);
    background: var(--paper);
  }

  .editorial-profile h2 {
    margin: 0 0 8px;
    font-size: 1.05rem;
    letter-spacing: 0;
  }

  .editorial-profile p {
    max-width: 66ch;
    margin: 0;
    color: var(--muted);
    font-size: 0.9rem;
    font-weight: 560;
    line-height: 1.65;
  }

  dl { margin: 0; }

