---
import { parts, pets, type Locale, type Pet } from "@jojo-codex-pet/catalog";
import { petProfiles } from "../content/petProfiles";
import { localize, route, ui } from "../lib/i18n";
import { installCommandsFor, openInCodexUrlFor, packageUrlFor } from "../lib/install-links";
import InstallActionTracking from "./InstallActionTracking.astro";

interface Props { locale: Locale; pet: Pet }
const { locale, pet } = Astro.props;
const copy = ui[locale];
const name = localize(pet.name, locale);
const isReview = pet.status === "pilot-review" || pet.status === "wave-review";
const part = parts.find((item) => item.number === pet.part)!;
const partTitle = localize(part.title, locale);
const wave = pet.part <= 3 ? 1 : pet.part <= 6 ? 2 : 3;
const displayImage = pet.image?.replace(/\.png$/, "-card.webp");
const imageAlt = locale === "en"
  ? `${name}, Part ${pet.part} pixel Codex pet`
  : `${name}，JoJo 第 ${pet.part} 部像素 Codex 宠物`;
const related = [pet.ownerId, ...(pet.pairIds ?? [])].flatMap((id) => {
  if (!id) return [];
  const match = pets.find((item) => item.id === id);
  return match ? [match] : [];
});
const profile = petProfiles[pet.id];
const packageUrl = pet.packagePath ? packageUrlFor(pet.packagePath) : undefined;
const openInCodexUrl = pet.packagePath ? openInCodexUrlFor({ nameEn: pet.name.en, packagePath: pet.packagePath }) : undefined;
const commands = packageUrl ? installCommandsFor(pet.id) : undefined;
const installCommands = commands ? [
  { method: "bash", label: "Bash · macOS / Linux", command: commands.bash },
  { method: "powershell", label: "PowerShell · Windows", command: commands.powershell },
  { method: "npx", label: "npx · cross-platform", command: commands.npx }
] : [];
const content = locale === "en" ? {
  identity: "Catalog identity",
  relationship: "Stand relationship",
  ability: "Ability modes inside this pet",
  palette: "Locked signature palette",
  source: "Source",
  install: "Install this pet",
  installAnchor: "All install methods ↓",
  pending: "This pet is not installable yet. Its complete v2 animation and QA package must pass before installation is enabled.",
  reviewPending: "Engineering QA is complete. Public installation remains disabled until final owner animation approval.",
  ready: "The complete v2 atlas passed deterministic validation, three blind direction reviews, and independent visual QA. Every method below installs only this pet.",
  overview: `${name} is the ${copy.role[pet.role].toLowerCase()} ${copy.type[pet.type].toLowerCase()} entry for Part ${pet.part}, ${partTitle}, in the 36-pet headline roster.`,
  released: `${name} is released as a validated Codex Pet V2 package from Wave ${wave}.`,
  review: `${name}'s complete V2 atlas passed engineering QA and is waiting for final owner animation approval before release.`,
  planned: `${name} is assigned to Wave ${wave}. Its base art, complete V2 animation, package validation, and visual QA are not published yet.`,
  views: "Public page views",
  openInCodex: "Open in Codex",
  download: "Package files",
  methodsLabel: "Available install methods",
  methods: ["Codex app", "Bash", "PowerShell", "npx"],
  profileLabel: "Pet dossier",
  copy: "Copy",
  copied: "Copied",
  copyFailed: "Copy failed"
} : {
  identity: "目录身份",
  relationship: "替身关系",
  ability: "包含在本宠物中的能力模式",
  palette: "锁定标志配色",
  source: "来源",
  install: "安装这只宠物",
  installAnchor: "全部安装方式 ↓",
  pending: "这只宠物暂不可安装。完整 V2 动画和 QA 包通过后才会启用安装。",
  reviewPending: "工程 QA 已完成；公开安装仍保持关闭，等待站长最终动画审核通过。",
  ready: "完整 V2 图集已通过确定性校验、三次盲测方向审核和独立视觉 QA。以下每种方式都只安装当前这只宠物。",
  overview: `${name}是 36 只首发名单中 JoJo 第 ${pet.part} 部《${partTitle}》的${copy.role[pet.role]}${copy.type[pet.type]}宠物。`,
  released: `${name}已在第 ${wave} 波次作为通过验证的 Codex Pet V2 包发布。`,
  review: `${name}的完整 V2 图集已通过工程 QA，正在等待站长最终动画审核后发布。`,
  planned: `${name}属于第 ${wave} 波次，基础造型、完整 V2 动画、宠物包验证与视觉 QA 尚未发布。`,
  views: "公开页面浏览次数",
  openInCodex: "在 Codex 中打开",
  download: "宠物包文件",
  methodsLabel: "可用安装方式",
  methods: ["Codex 应用", "Bash", "PowerShell", "npx"],
  profileLabel: "宠物档案",
  copy: "复制",
  copied: "已复制",
  copyFailed: "复制失败"
};
---

<div class="detail-grid">
  <div class="detail-side">
    <div class="detail-art" style={`--accent:${part.accent}`}>
      {displayImage ? (
        <img src={displayImage} alt={imageAlt} width="640" height="640" loading="eager" fetchpriority="high" decoding="async" />
      ) : (
        <div class="planned-sigil" aria-hidden="true"><span>{String(pet.part).padStart(2, "0")}</span><i>{pet.type === "character" ? "C" : "S"}</i></div>
      )}
      <span class="detail-part">PART {String(pet.part).padStart(2, "0")}</span>
      {pet.status === "released" && packageUrl && openInCodexUrl && (
        <div class="detail-art-actions" role="group" aria-label={content.install}>
          <a
            class="button"
            href={openInCodexUrl}
            data-install-deeplink
            data-action-pet-id={pet.id}
            data-action-method="codex"
            data-action-locale={locale}
          >
            {content.openInCodex} ↗
          </a>
          <a class="button quick-package-link" href={`${packageUrl}/pet.json`}>{content.download} ↗</a>
          <a class="quick-methods-link" href="#install-this-pet">{content.installAnchor}</a>
        </div>
      )}
    </div>
    <div class="pet-summary">
      <p class="part-title">{localize(part.title, locale)} · {copy.role[pet.role]}</p>
      <p class="pet-overview">{content.overview}</p>
      <p class="status-note">{pet.status === "released" ? content.released : isReview ? content.review : content.planned}</p>
    </div>
  </div>
  <div class="detail-copy">
    <div class="detail-heading">
      <div class="detail-pills"><span class="status-pill" data-status={pet.status}>{copy.status[pet.status]}</span><span class="type-pill">{copy.type[pet.type]}</span></div>
      <h1>{name}</h1>
    </div>
    <section class="install-box" id="install-this-pet">
      <div class="install-heading">
        <h2>{content.install}</h2>
        {pet.status === "released" && packageUrl && (
          <ul class="install-method-overview" aria-label={content.methodsLabel}>
            {content.methods.map((method) => <li>{method}</li>)}
          </ul>
        )}
      </div>
      {pet.status === "released" && packageUrl && openInCodexUrl ? (
        <>
          <p>{content.ready}</p>
          <div class="install-primary">
            <a
              class="button"
              href={openInCodexUrl}
              data-install-deeplink
              data-action-pet-id={pet.id}
              data-action-method="codex"
              data-action-locale={locale}
            >
              {content.openInCodex} ↗
            </a>
            <a class="button package-link" href={`${packageUrl}/pet.json`}>{content.download} ↗</a>
          </div>
          <div class="command-list">
            {installCommands.map(({ method, label, command }) => (
              <div class="command-row">
                <span>{label}</span>
                <code>{command}</code>
                <button
                  type="button"
                  data-copy-command={command}
                  data-copy-label={content.copy}
                  data-copied-label={content.copied}
                  data-copy-failed-label={content.copyFailed}
                  data-action-pet-id={pet.id}
                  data-action-method={method}
                  data-action-locale={locale}
                  aria-live="polite"
                >
                  {content.copy}
                </button>
              </div>
            ))}
          </div>
        </>
      ) : (
        <><p>{isReview ? content.reviewPending : content.pending}</p><button class="button" type="button" disabled aria-disabled="true">{isReview ? copy.reviewNotInstallable : copy.notInstallable}</button></>
      )}
    </section>
    <dl>
      <div><dt>{content.identity}</dt><dd><code>{pet.id}</code></dd></div>
      <div><dt>{content.views}</dt><dd><span data-view-count={pet.id}>— {copy.view}</span></dd></div>
      {related.length > 0 && (
        <div>
          <dt>{content.relationship}</dt>
          <dd>{related.map((item, index) => <><a href={route(locale, `/pets/${item.id}/`)}>{localize(item.name, locale)}</a>{index < related.length - 1 ? " · " : ""}</>)}</dd>
        </div>
      )}
      {pet.abilityModes && <div><dt>{content.ability}</dt><dd>{pet.abilityModes.map((mode) => localize(mode, locale)).join(" · ")}</dd></div>}
      {pet.palette && <div><dt>{content.palette}</dt><dd class="detail-palette">{pet.palette.map((color) => <span style={`--swatch:${color}`}><i>{color}</i></span>)}</dd></div>}
      <div><dt>{content.source}</dt><dd><a href={pet.source}>geoqiao/jojo-codex-pet ↗</a></dd></div>
    </dl>
  </div>
</div>
{profile && (
  <section class="editorial-profile" data-editorial-profile={pet.id} aria-label={locale === "en" ? "Pet profile" : "宠物资料"}>
    <p class="profile-label">{content.profileLabel}</p>
    <div class="profile-grid">
      {Object.entries(profile).map(([sectionKey, section]) => (
        <article data-profile-section={sectionKey}>
          <h2>{section.title[locale]}</h2>
          <p>{section.body[locale]}</p>
        </article>
      ))}
    </div>
  </section>
)}
<InstallActionTracking />

<style>
  .detail-grid {
    display: grid;
    grid-template-columns: minmax(300px, 0.7fr) minmax(0, 1fr);
    align-items: start;
    border: 3px solid var(--ink);
    background: var(--paper-bright);
    box-shadow: var(--shadow);
  }

  .detail-side {
    position: sticky;
    top: 104px;
    align-self: start;
    min-width: 0;
    border-right: 3px solid var(--ink);
  }

  .detail-art {
    display: grid;
    position: relative;
    min-height: 560px;
    place-items: center;
    overflow: hidden;
    background:
      linear-gradient(140deg, rgb(255 255 255 / 38%) 0 14%, transparent 14% 68%, rgb(23 19 30 / 18%) 68%),
      var(--accent);
    border-bottom: 3px solid var(--ink);
  }

  .detail-art::before {
    position: absolute;
    width: 78%;
    aspect-ratio: 1;
    content: "";
    border: 34px solid rgb(255 255 255 / 24%);
    border-radius: 50%;
    rotate: -14deg;
  }

  .detail-art img {
    position: relative;
    z-index: 1;
    width: 88%;
    height: 510px;
    object-fit: contain;
    image-rendering: pixelated;
    filter: drop-shadow(8px 9px 0 rgb(23 19 30 / 42%));
  }

  .detail-part {
    position: absolute;
    z-index: 2;
    top: 24px;
    left: 24px;
    padding: 7px 11px;
    color: var(--paper-bright);
    background: var(--ink);
    font-size: 0.68rem;
    font-weight: 850;
    letter-spacing: 0.13em;
  }

  .detail-art-actions {
    position: absolute;
    z-index: 3;
    right: 24px;
    bottom: 24px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: end;
  }

  .detail-art-actions .button {
    padding: 11px 14px;
    font-size: 0.62rem;
  }

  .detail-art-actions .quick-package-link {
    background: var(--paper-bright);
  }

  .quick-methods-link {
    flex-basis: 100%;
    justify-self: end;
    padding: 4px 7px;
    color: var(--paper-bright);
    background: var(--ink);
    font-size: 0.58rem;
    font-weight: 850;
    letter-spacing: 0.08em;
    text-align: right;
    text-underline-offset: 3px;
    text-transform: uppercase;
  }

  .planned-sigil {
    position: relative;
    z-index: 1;
    display: grid;
    width: 250px;
    height: 310px;
    place-items: center;
    color: var(--paper-bright);
    background: var(--ink);
    clip-path: polygon(16% 0, 86% 7%, 100% 52%, 74% 100%, 7% 90%, 0 35%);
  }

  .planned-sigil span {
    font-family: "Bodoni Moda Variable", Georgia, serif;
    font-size: 8rem;
    font-weight: 900;
  }

  .planned-sigil i {
    position: absolute;
    right: 32px;
    bottom: 26px;
    color: var(--acid);
    font-style: normal;
    font-weight: 900;
  }

  .detail-copy { min-width: 0; padding: clamp(28px, 3.8vw, 54px); }
  .detail-pills { display: flex; gap: 8px; }

  h1 {
    margin: 20px 0 14px;
    font-family: "Bodoni Moda Variable", Georgia, serif;
    font-size: clamp(4rem, 7.2vw, 7.4rem);
    letter-spacing: -0.07em;
    line-height: 0.92;
  }

  .part-title {
    margin: 0;
    color: var(--muted);
    font-size: 0.78rem;
    font-weight: 850;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .pet-overview {
    max-width: 66ch;
    margin: 14px 0 0;
    color: var(--muted);
    font-size: 0.95rem;
    font-weight: 620;
    line-height: 1.65;
  }

  .status-note {
    margin: 18px 0 0;
    padding: 11px 14px;
    border: 2px solid var(--ink);
    background: var(--acid);
    font-weight: 720;
  }

  .pet-summary {
    padding: 22px 24px 24px;
    background: var(--paper-bright);
  }

  .editorial-profile {
    margin-top: clamp(28px, 4vw, 48px);
    border: 3px solid var(--ink);
    background: var(--ink);
    box-shadow: var(--shadow);
  }

  .profile-label {
    margin: 0;
    padding: 12px 16px;
    color: var(--acid);
    font-size: 0.66rem;
    font-weight: 850;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .profile-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 3px;
    background: var(--ink);
  }

  .editorial-profile article {
    min-width: 0;
    padding: 22px 24px 24px;
    border-top: 5px solid var(--violet);
    background: var(--paper);
  }

  .editorial-profile h2 {
    margin: 0 0 8px;
    font-size: 1.05rem;
    letter-spacing: 0;
  }

  .editorial-profile p {
    max-width: 66ch;
    margin: 0;
    color: var(--muted);
    font-size: 0.9rem;
    font-weight: 560;
    line-height: 1.65;
  }

  dl { margin: 0; }

  dl > div {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 18px;
    padding: 14px 0;
    border-top: 2px solid var(--ink);
  }

  dt {
    font-size: 0.68rem;
    font-weight: 850;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  dd { margin: 0; font-weight: 620; }
  dd a { text-underline-offset: 4px; }
  code { font-size: 0.78rem; }

  .detail-palette { display: flex; flex-wrap: wrap; gap: 8px; }

  .detail-palette span {
    display: grid;
    width: 86px;
    height: 42px;
    align-items: end;
    padding: 4px;
    border: 2px solid var(--ink);
    background: var(--swatch);
  }

  .detail-palette i {
    padding: 2px 4px;
    color: var(--paper-bright);
    background: var(--ink);
    font-size: 0.55rem;
    font-style: normal;
  }

  .install-box {
    margin-top: 20px;
    scroll-margin-top: 110px;
    padding: clamp(18px, 2.4vw, 26px);
    color: var(--paper-bright);
    background: var(--ink);
  }

  .install-heading {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 16px;
    align-items: end;
  }

  .install-box h2 {
    margin: 0;
    font-family: "Bodoni Moda Variable", Georgia, serif;
    font-size: clamp(2rem, 3.2vw, 3rem);
    line-height: 0.95;
  }

  .install-box p {
    max-width: 68ch;
    margin: 14px 0 0;
    color: #d8d1dd;
    font-size: 0.84rem;
    line-height: 1.5;
  }

  .install-method-overview {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    justify-content: end;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .install-method-overview li {
    padding: 5px 7px;
    border: 1px solid rgb(255 255 255 / 45%);
    color: var(--acid);
    font-size: 0.58rem;
    font-weight: 850;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .install-primary {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    align-items: center;
    margin-top: 16px;
  }

  .package-link {
    color: var(--paper-bright);
    background: transparent;
    border-color: var(--paper-bright);
    box-shadow: 4px 4px 0 var(--paper-bright);
  }

  .command-list {
    display: grid;
    gap: 10px;
    margin-top: 20px;
  }

  .command-row {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr) auto;
    gap: 12px;
    align-items: center;
    padding: 12px;
    border: 1px solid rgb(255 255 255 / 35%);
  }

  .command-row > span {
    color: var(--acid);
    font-size: 0.65rem;
    font-weight: 850;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .command-row code {
    min-width: 0;
    overflow-x: auto;
    color: var(--paper-bright);
    font-size: 0.68rem;
    white-space: nowrap;
  }

  .command-row button {
    min-width: 44px;
    min-height: 44px;
    padding: 6px 10px;
    border: 1px solid var(--paper-bright);
    color: var(--paper-bright);
    background: transparent;
    font-size: 0.62rem;
    font-weight: 850;
    cursor: pointer;
  }

  .detail-art-actions a:focus-visible,
  .install-primary a:focus-visible,
  .command-row button:focus-visible,
  dd a:focus-visible {
    outline: 3px solid var(--paper-bright);
    outline-offset: 2px;
    box-shadow: 0 0 0 6px var(--ink);
    transition: none;
  }

  @media (max-width: 760px) {
    .detail-grid {
      display: flex;
      flex-direction: column;
      align-items: stretch;
    }

    .detail-side,
    .detail-copy { display: contents; }

    .detail-art {
      order: 1;
      position: relative;
      top: auto;
      min-height: 300px;
      border-right: 0;
      border-bottom: 3px solid var(--ink);
    }

    .detail-heading {
      order: 2;
      padding: 24px 20px 0;
    }

    .pet-summary {
      order: 3;
      padding: 16px 20px 22px;
    }

    .install-box {
      order: 4;
      margin: 0 20px 24px;
    }

    dl {
      order: 5;
      padding: 0 20px 26px;
    }

    .detail-art img { height: 278px; }
    .detail-art-actions { right: 12px; bottom: 12px; left: 12px; }
    .detail-part { top: 14px; left: 14px; }
  }

  @media (max-width: 980px) {
    .profile-grid { grid-template-columns: 1fr; }
  }

  @media (max-width: 600px) {
    .detail-heading { padding: 22px 16px 0; }
    h1 { font-size: clamp(3.2rem, 17vw, 4.5rem); }
    .pet-summary { padding: 14px 16px 20px; }
    .pet-overview { font-size: 0.9rem; line-height: 1.5; }
    .status-note { margin-top: 14px; padding: 10px 12px; }
    .install-box { margin: 0 16px 20px; }
    .install-heading { grid-template-columns: 1fr; }
    .install-method-overview { justify-content: start; }
    dl { padding: 0 16px 24px; }
    dl > div { grid-template-columns: 1fr; gap: 5px; }
    .command-row { grid-template-columns: 1fr auto; }
    .command-row code { grid-column: 1 / -1; grid-row: 2; }
    .editorial-profile { margin-top: 24px; }
    .editorial-profile article { padding: 18px 16px 20px; }
  }

  @media (max-height: 860px) and (min-width: 761px) {
    .detail-side {
      position: relative;
      top: auto;
    }
  }
</style>
