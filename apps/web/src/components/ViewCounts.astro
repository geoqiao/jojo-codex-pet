---
interface Props {
  incrementId: string;
}

const { incrementId } = Astro.props;
---

<script is:inline define:vars={{ incrementId }}>
  // Records one page view for the pet; the aggregate is stored server-side and is not shown to visitors.
  fetch("/api/views.php", {
    method: "POST",
    headers: { "content-type": "application/json" },
    body: JSON.stringify({ pet_id: incrementId })
  }).catch(() => {
    // The static page stays usable if the counter endpoint is unavailable.
  });
</script>
